                                            <StackPanel>
                                                <TextBlock Text="CHAT HISTORY &amp; AI AGENT MEMORY PATHS" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushAccentLight}" FontFamily="Consolas" Margin="0,0,0,10"/>

                                                <!-- Chat History Path -->
                                                <TextBlock Text="Chat History Saved Path (Home &amp; Workspace Transcripts)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="{DynamicResource BrushInputBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,6,0">
                                                        <TextBox x:Name="TxtPathChatHistory" IsReadOnly="True" Background="Transparent" Foreground="{DynamicResource BrushTextPrimary}" BorderThickness="0" FontSize="11" FontFamily="Consolas"/>
                                                    </Border>
                                                    <Button Grid.Column="1" Content="Copy" Style="{StaticResource BlackBoxActionBtn}" Padding="10,5" Margin="0,0,6,0" Click="BtnCopyChatHistoryPath_Click"/>
                                                    <Button Grid.Column="2" Content="Open" Style="{StaticResource BlackBoxActionBtn}" Padding="10,5" Click="BtnOpenChatHistoryPath_Click"/>
                                                </Grid>

                                                <!-- AI Agent Memory Path -->
                                                <TextBlock Text="AI Agent Memory Saved Path (Per-Project Durable Memory)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="{DynamicResource BrushInputBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,6,0">
                                                        <TextBox x:Name="TxtPathAgentMemory" IsReadOnly="True" Background="Transparent" Foreground="{DynamicResource BrushTextPrimary}" BorderThickness="0" FontSize="11" FontFamily="Consolas"/>
                                                    </Border>
                                                    <Button Grid.Column="1" Content="Copy" Style="{StaticResource BlackBoxActionBtn}" Padding="10,5" Margin="0,0,6,0" Click="BtnCopyAgentMemoryPath_Click"/>
                                                    <Button Grid.Column="2" Content="Open" Style="{StaticResource BlackBoxActionBtn}" Padding="10,5" Click="BtnOpenAgentMemoryPath_Click"/>
                                                </Grid>

                                                <!-- Settings & App Data Path -->
                                                <TextBlock Text="Settings &amp; Registry File (settings.json)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="{DynamicResource BrushInputBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,6,0">
                                                        <TextBox x:Name="TxtPathDataRoot" IsReadOnly="True" Background="Transparent" Foreground="{DynamicResource BrushTextMuted}" BorderThickness="0" FontSize="11" FontFamily="Consolas"/>
                                                    </Border>
                                                    <Button Grid.Column="1" Content="Copy" Style="{StaticResource BlackBoxActionBtn}" Padding="10,5" Margin="0,0,6,0" Click="BtnCopyDataRootPath_Click"/>
                                                    <Button Grid.Column="2" Content="Open" Style="{StaticResource BlackBoxActionBtn}" Padding="10,5" Click="BtnOpenDataRootPath_Click"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- User Profile Section -->
                                        <Border Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="OPERATOR PROFILE" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushAccentLight}" FontFamily="Consolas" Margin="0,0,0,10"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Display Name" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                                                        <Border Background="{DynamicResource BrushInputBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6">
                                                            <TextBox x:Name="TxtSettingsProfileName" Background="Transparent" Foreground="{DynamicResource BrushTextPrimary}" BorderThickness="0" FontSize="12" Text="Axion"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Status / Role Label" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                                                        <Border Background="{DynamicResource BrushInputBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6">
                                                            <TextBox x:Name="TxtSettingsProfileRole" Background="Transparent" Foreground="{DynamicResource BrushTextPrimary}" BorderThickness="0" FontSize="12" Text="Operator // Online"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Projects Directory -->
                                        <Border Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="DEFAULT WORKSPACE DIRECTORY" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushAccentLight}" FontFamily="Consolas" Margin="0,0,0,8"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="{DynamicResource BrushInputBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                                                        <TextBox x:Name="TxtSettingsProjectsDir" Background="Transparent" Foreground="{DynamicResource BrushAccentLight}" BorderThickness="0" FontSize="11" FontFamily="Consolas, Segoe UI"/>
                                                    </Border>
                                                    <Button Grid.Column="1" Content="Change..." Style="{StaticResource BlackBoxActionBtn}" Click="BtnBrowseSettingsFolder_Click"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Active Color Theme (Daylight / Slate / Midnight) + accent -->
                                        <Border Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="COLOR THEME &amp; ACCENT" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushAccentLight}" FontFamily="Consolas" Margin="0,0,0,6"/>
                                                <TextBlock Text="Select a base theme and accent color. Applies immediately." FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,10"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button x:Name="BtnSettingsThemeOled" Content="Midnight" Tag="Midnight" Click="BtnThemeSelect_Click" Style="{StaticResource BlackBoxActionBtn}" Margin="0,0,8,0"/>
                                                    <Button x:Name="BtnSettingsThemeMidnight" Content="Slate" Tag="Slate" Click="BtnThemeSelect_Click" Style="{StaticResource BlackBoxActionBtn}" Margin="0,0,8,0"/>
                                                    <Button x:Name="BtnSettingsThemeCarbon" Content="Daylight" Tag="Daylight" Click="BtnThemeSelect_Click" Style="{StaticResource BlackBoxActionBtn}"/>
                                                </StackPanel>
                                                <TextBlock Text="ACCENT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextDim}" FontFamily="Consolas" Margin="0,12,0,8"/>
                                                <StackPanel x:Name="AccentSwatchRow" Orientation="Horizontal"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Performance & Hardware Acceleration -->
                                        <Border Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Hardware Acceleration" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                    <TextBlock Text="Smooth vector scaling and fluid transitions" FontSize="11" Foreground="{DynamicResource BrushTextDim}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" x:Name="ChkHardwareAccel" IsChecked="True" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <!-- Discord Rich Presence -->
                                        <Border Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Discord Rich Presence" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                        <TextBlock Text="Publishes live Neural Net activity and session timer to your local Discord client" FontSize="11" Foreground="{DynamicResource BrushTextDim}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="1" x:Name="ChkDiscordPresence" IsChecked="False" VerticalAlignment="Center"/>
                                                </Grid>
                                                <TextBlock Text="Discord Application (Client) ID" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,10,0,4"/>
                                                <Border Background="{DynamicResource BrushInputBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6">
                                                    <TextBox x:Name="TxtDiscordClientId" Background="Transparent" Foreground="{DynamicResource BrushAccentLight}" BorderThickness="0" FontSize="11" FontFamily="Consolas, Segoe UI"/>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- Provider Icon Badge Geometry + Logo Cache -->
                                        <Border Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Provider Badge Shape" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,8"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton x:Name="RbIconSquircle" Content="Squircle" Foreground="{DynamicResource BrushTextPrimary}" FontSize="12" Margin="0,0,20,0" IsChecked="True" Checked="RbIconShape_Checked"/>
                                                        <RadioButton x:Name="RbIconCircle" Content="Circle" Foreground="{DynamicResource BrushTextPrimary}" FontSize="12" Checked="RbIconShape_Checked"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Open Logo Cache" Style="{StaticResource BlackBoxActionBtn}" VerticalAlignment="Center" Click="BtnOpenLogoCache_Click"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>

                            <!-- Bottom Action Bar -->
                            <Grid Grid.Row="3" Margin="0,12,0,0">
                                <Button Content="Test All Connections" Style="{StaticResource BlackBoxActionBtn}" HorizontalAlignment="Left" Click="BtnTestApiKeys_Click"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Cancel" Style="{StaticResource BlackBoxActionBtn}" Margin="0,0,8,0" Click="BtnCloseSettings_Click"/>
                                    <Button Content="Save &amp; Apply" Style="{StaticResource PrimaryActionBtn}" Click="BtnSaveSettings_Click"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ================= API KEY REQUIRED MODAL ================= -->
                <Grid x:Name="ModalApiKeyPrompt" Visibility="Collapsed" Background="#bb000000" Grid.ColumnSpan="2" Grid.RowSpan="3" Panel.ZIndex="60" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="ApiKeyPromptModalScale" ScaleX="1.0" ScaleY="1.0"/>
                    </Grid.RenderTransform>
                    <Border Width="560" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="2" Opacity="0.55"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Header -->
                                <RowDefinition Height="Auto"/> <!-- Provider Info Card -->
                                <RowDefinition Height="Auto"/> <!-- Key Input Section -->
                                <RowDefinition Height="Auto"/> <!-- Actions -->
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔑" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="API Key Required" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtPromptSubtitle" Text="To load and chat with this cloud model, enter your API key below." FontSize="12" Foreground="{DynamicResource BrushTextMuted}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Content="✕" Style="{StaticResource BlackBoxActionBtn}" HorizontalAlignment="Right" VerticalAlignment="Top" Width="30" Height="30" Padding="0" Click="BtnCloseApiKeyPrompt_Click"/>
                            </Grid>

                            <!-- Provider Info Card -->
                            <Border Grid.Row="1" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Provider Logo (No Emoji Overlay) -->
                                    <Border Grid.Column="0" Width="44" Height="44" Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="{DynamicResource ProviderLogoCornerRadius}" VerticalAlignment="Center" Margin="0,0,12,0" SnapsToDevicePixels="True">
                                        <Border CornerRadius="{DynamicResource ProviderLogoInnerCornerRadius}">
                                            <Grid>
                                                <TextBlock x:Name="TxtPromptFallbackIcon" Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image x:Name="ImgPromptLogo" Stretch="Uniform" Margin="4" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Grid>
                                        </Border>
                                    </Border>

                                    <!-- Target Model & Company -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtPromptTargetModel" Text="Target Model: GPT-4o" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <TextBlock x:Name="TxtPromptTargetCompany" Text="Company: OpenAI" FontSize="11" Foreground="{DynamicResource BrushAccentLight}" FontFamily="Consolas"/>
                                        <TextBlock x:Name="TxtPromptEndpoint" Text="Endpoint: https://api.openai.com/v1/chat/completions" FontSize="10" Foreground="{DynamicResource BrushTextDim}" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- External Key Portal Link Button -->
                                    <Button Grid.Column="2" x:Name="BtnPromptOpenPortal" Content="↗ Get Key" Style="{StaticResource BlackBoxActionBtn}" VerticalAlignment="Center" Padding="10,6" Click="BtnPromptOpenPortal_Click"/>
                                </Grid>
                            </Border>

                            <!-- Key Input Section -->
                            <StackPanel Grid.Row="2" Margin="0,0,0,20">
                                <TextBlock x:Name="TxtPromptKeyLabel" Text="OPENAI API KEY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" FontFamily="Consolas" Margin="0,0,0,6"/>
                                <Grid>
                                    <TextBox x:Name="TxtPromptKeyInput" Style="{StaticResource ModernDarkTextBox}" Height="40" Padding="12,0" FontSize="13" FontFamily="Consolas" KeyDown="TxtPromptKeyInput_KeyDown"/>
                                </Grid>
                                <TextBlock x:Name="TxtPromptKeyHint" Text="Key is saved locally in settings.json with AES-ready encryption and never shared." FontSize="11" Foreground="{DynamicResource BrushTextDim}" Margin="0,6,0,0"/>
                            </StackPanel>

                            <!-- Actions -->
                            <Grid Grid.Row="3">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Cancel" Style="{StaticResource BlackBoxActionBtn}" Margin="0,0,10,0" Padding="16,8" Click="BtnCloseApiKeyPrompt_Click"/>
                                    <Button x:Name="BtnPromptSaveAndLoad" Content="⚡ Save &amp; Load Model" Style="{StaticResource PrimaryActionBtn}" Padding="20,8" Click="BtnPromptSaveAndLoad_Click"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ================= 20-SECOND CINEMATIC LOADING SCREEN ================= -->
                <Grid x:Name="LoadingOverlay" Visibility="Collapsed" Background="{DynamicResource BrushWindowBg}" Grid.ColumnSpan="2" Grid.RowSpan="3" Panel.ZIndex="100" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="LoadingOverlayScale" ScaleX="1.0" ScaleY="1.0"/>
                    </Grid.RenderTransform>

                    <!-- Laser Sweep Line -->
                    <Border Height="2" Width="600" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="#00f2fe" Offset="0.5"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="ScanBeamTranslate" Y="0"/>
                        </Border.RenderTransform>
                    </Border>

                    <!-- Top Right Skip Button -->
                    <Button x:Name="BtnSkipLoading" Content="⏩ Skip Boot (Esc)" Style="{StaticResource BlackBoxActionBtn}" 
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,18,0" Padding="12,6" FontSize="11" 
                            Click="BtnSkipLoading_Click"/>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- 3D Gyro Quantum Reactor -->
                        <Grid Width="130" Height="130" HorizontalAlignment="Center" Margin="0,0,0,18">
                            <!-- Outer HUD Ring with Orbital Node -->
                            <Border Width="120" Height="120" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1.5" CornerRadius="60" Opacity="0.6"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <RotateTransform x:Name="OuterRingRotate" Angle="0"/>
                                </Border.RenderTransform>
                                <Border Width="8" Height="8" Background="{DynamicResource BrushAccent}" CornerRadius="4" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,-4,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#00f2fe" BlurRadius="10" ShadowDepth="0"/>
                                    </Border.Effect>
                                </Border>
                            </Border>

                            <!-- Mid Counter-Rotating Diamond / Shield -->
                            <Border Width="92" Height="92" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1.5" CornerRadius="12" Opacity="0.75"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <RotateTransform x:Name="MidDiamondRotate" Angle="45"/>
                                </Border.RenderTransform>
                            </Border>

                            <!-- Glowing Core Cube -->
                            <Border x:Name="CoreCubeBorder" Width="52" Height="52" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="2" CornerRadius="12"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="CoreCubeGlow" Color="#00f2fe" BlurRadius="28" ShadowDepth="0" Opacity="0.9"/>
                                </Border.Effect>
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="CoreCubeScale" ScaleX="1.0" ScaleY="1.0"/>
                                </Border.RenderTransform>
                                <Path Data="M 4,14 L 18,5 L 32,14 L 32,32 L 18,41 L 4,32 Z M 4,14 L 18,23 L 32,14 M 18,23 L 18,41" 
                                      Stroke="{DynamicResource BrushAccent}" StrokeThickness="1.8" Stretch="Uniform" Margin="9"/>
                            </Border>
                        </Grid>

                        <!-- Brand Title & Tagline -->
                        <TextBlock Text="LLMODEL BOX" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" FontFamily="Segoe UI, Consolas"/>
                        <TextBlock Text="QUANTUM BLACKBOX ENGINE // 20-SECOND SYSTEM DIAGNOSTIC" FontSize="11" Foreground="{DynamicResource BrushAccentLight}" HorizontalAlignment="Center" Margin="0,5,0,16" FontFamily="Consolas"/>

                        <!-- Phase Milestone Indicators (6 Steps) -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <Border x:Name="PhaseChip1" Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="3,0">
                                <TextBlock x:Name="TxtPhase1" Text="01 KERNEL" FontSize="9" Foreground="{DynamicResource BrushTextDim}" FontFamily="Consolas"/>
                            </Border>
                            <Border x:Name="PhaseChip2" Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="3,0">
                                <TextBlock x:Name="TxtPhase2" Text="02 TLS 1.3" FontSize="9" Foreground="{DynamicResource BrushTextDim}" FontFamily="Consolas"/>
                            </Border>
                            <Border x:Name="PhaseChip3" Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="3,0">
                                <TextBlock x:Name="TxtPhase3" Text="03 GATEWAYS" FontSize="9" Foreground="{DynamicResource BrushTextDim}" FontFamily="Consolas"/>
                            </Border>
                            <Border x:Name="PhaseChip4" Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="3,0">
                                <TextBlock x:Name="TxtPhase4" Text="04 MODELS" FontSize="9" Foreground="{DynamicResource BrushTextDim}" FontFamily="Consolas"/>
                            </Border>
                            <Border x:Name="PhaseChip5" Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="3,0">
                                <TextBlock x:Name="TxtPhase5" Text="05 VAULT" FontSize="9" Foreground="{DynamicResource BrushTextDim}" FontFamily="Consolas"/>
                            </Border>
                            <Border x:Name="PhaseChip6" Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="3,0">
                                <TextBlock x:Name="TxtPhase6" Text="06 READY" FontSize="9" Foreground="{DynamicResource BrushTextDim}" FontFamily="Consolas"/>
                            </Border>
                        </StackPanel>

                        <!-- Progress Bar Container -->
                        <Border Width="480" Height="6" Background="{DynamicResource BrushCardBg}" CornerRadius="3" ClipToBounds="True" HorizontalAlignment="Center" Margin="0,0,0,10">
                            <ProgressBar x:Name="LoadingProgressBar" Minimum="0" Maximum="100" Value="0" Height="6" 
                                         Foreground="{DynamicResource BrushAccentLight}" Background="Transparent" BorderThickness="0"/>
                        </Border>

                        <!-- Countdown Timer & Current Status Text -->
                        <Grid Width="480" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource BrushSuccess}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="TxtLoadingStatus" Text="Bootstrapping BlackBox core systems..." FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" FontFamily="Consolas"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtLoadingTimer" Text="00:00.0 / 00:10.0 (0%)" FontSize="11" Foreground="{DynamicResource BrushAccentLight}" FontFamily="Consolas" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Cyber Telemetry Console Box -->
                        <Border Width="500" Height="74" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                            <ScrollViewer x:Name="LoadingTelemetryScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                <TextBlock x:Name="TxtTelemetryFeed" Text="[00.0s] [SYS] Quantum boot protocol initiated..." FontSize="10" Foreground="{DynamicResource BrushTextDim}" FontFamily="Consolas" TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ================= 3. STATUS BAR ================= -->
            <Border Grid.Row="2" Background="{DynamicResource BrushWindowBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0" Padding="14,0">
                <Grid VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource IdeStatusBadgeOk}" VerticalAlignment="Center" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource BrushSuccess}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="Online" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushSuccess}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="LlmodelBox Core v1.0" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" FontFamily="Consolas" VerticalAlignment="Center"/>
                        <TextBlock Text=" | Host: Windows 10 x64" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" FontFamily="Consolas" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtWindowMode" Text=" | Windowed" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" FontFamily="Consolas" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnToggleOutput" Content="&#9776; Output" Style="{StaticResource IdeButton}" FontSize="10.5" Padding="8,2" Margin="0,0,10,0" ToolTip="Toggle Output / Terminal panel" Click="BtnToggleOutput_Click"/>
                        <TextBlock Text="BLACKBOX ACTIVE" FontSize="11" Foreground="{DynamicResource BrushSuccess}" FontWeight="SemiBold" FontFamily="Consolas" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= COMMAND PALETTE (Ctrl+K) ================= -->
            <Grid x:Name="CommandPalette" Visibility="Collapsed" Background="#cc010104" Grid.RowSpan="3" Panel.ZIndex="200" MouseLeftButtonDown="PaletteScrim_Click">
                <Border Width="560" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,96,0,0"
                        Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="34" ShadowDepth="0" Opacity="0.6"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border Padding="14,12" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="{StaticResource IconSearch}" Fill="{DynamicResource BrushTextMuted}" Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center" Margin="2,0,10,0"/>
                                <TextBox x:Name="TxtPaletteSearch" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource BrushTextPrimary}" CaretBrush="{DynamicResource BrushAccentLight}"
                                         FontSize="15" VerticalAlignment="Center"
                                         TextChanged="TxtPaletteSearch_TextChanged" KeyDown="TxtPaletteSearch_KeyDown"/>
                            </Grid>
                        </Border>
                        <ListBox x:Name="PaletteList" MaxHeight="360" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="6">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent" Padding="12,10" CornerRadius="6" Tag="{Binding}" MouseLeftButtonUp="PaletteRow_Click">
                                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource BrushTextPrimary}" FontSize="13"/>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>



