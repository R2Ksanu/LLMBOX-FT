<Window x:Class="LlmodelBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:LlmodelBox.Controls"
        xmlns:common="clr-namespace:LlmodelBox.Common"
        mc:Ignorable="d"
        Title="LlmodelBox // BlackBox Edition"
        Height="720" Width="1140"
        MinHeight="540" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushWindowBg}"
        Foreground="{DynamicResource BrushTextPrimary}"
        FontFamily="Segoe UI, Consolas, sans-serif"
        WindowStyle="None"
        KeyDown="Window_KeyDown"
        StateChanged="Window_StateChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome x:Name="AppChrome"
                      CaptionHeight="42" 
                      CornerRadius="0" 
                      GlassFrameThickness="0" 
                      ResizeBorderThickness="6" 
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- ================= SAAS OLED DYNAMIC THEME SYSTEM (OLED / MIDNIGHT / CARBON) ================= -->
        <SolidColorBrush x:Key="BrushWindowBg" Color="#000000"/>
        <SolidColorBrush x:Key="BrushTitleBarBg" Color="#050507"/>
        <SolidColorBrush x:Key="BrushCardBg" Color="#08080a"/>
        <SolidColorBrush x:Key="BrushCardInnerBg" Color="#0e0e12"/>
        <SolidColorBrush x:Key="BrushInputBg" Color="#08080c"/>
        <SolidColorBrush x:Key="BrushBorder" Color="#1c1c22"/>
        <SolidColorBrush x:Key="BrushBorderSubtle" Color="#131317"/>
        <SolidColorBrush x:Key="BrushBorderHover" Color="#32323d"/>
        <SolidColorBrush x:Key="BrushAccent" Color="#6366f1"/>
        <SolidColorBrush x:Key="BrushAccentLight" Color="#818cf8"/>
        <SolidColorBrush x:Key="BrushAccentGlow" Color="#1e1b4b"/>
        <SolidColorBrush x:Key="BrushAccentMuted" Color="#312e81"/>
        <SolidColorBrush x:Key="BrushAccentText" Color="#ffffff"/>
        <SolidColorBrush x:Key="BrushTextPrimary" Color="#fafafa"/>
        <SolidColorBrush x:Key="BrushTextSecondary" Color="#a1a1aa"/>
        <SolidColorBrush x:Key="BrushTextMuted" Color="#71717a"/>
        <SolidColorBrush x:Key="BrushTextDim" Color="#52525b"/>
        <SolidColorBrush x:Key="BrushSuccess" Color="#22c55e"/>
        <SolidColorBrush x:Key="BrushSuccessGlow" Color="#052e16"/>
        <SolidColorBrush x:Key="BrushDanger" Color="#f43f5e"/>
        <SolidColorBrush x:Key="BrushDangerGlow" Color="#4c0519"/>
        <SolidColorBrush x:Key="BrushWarning" Color="#f59e0b"/>
        <SolidColorBrush x:Key="BrushWarningGlow" Color="#451a03"/>

        <!-- Tiny Top Menu Bar Button (Antigravity-style clean header action) -->
        <Style x:Key="TopMenuBarBtn" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushCardInnerBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushBorderSubtle}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented Theme Pill Button Style with Smooth Translucent Highlight & Scale -->
        <Style x:Key="ThemePillBtn" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="pillBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="pillScale" ScaleX="1.0" ScaleY="1.0"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pillBorder" Property="Background" Value="{DynamicResource BrushBorderHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                                <Setter TargetName="pillBorder" Property="BorderBrush" Value="{DynamicResource BrushBorderHover}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="pillScale" Storyboard.TargetProperty="ScaleX" To="1.04" Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="pillScale" Storyboard.TargetProperty="ScaleY" To="1.04" Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="pillScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="pillScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="pillBorder" Property="Background" Value="{DynamicResource BrushBorderHover}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="pillScale" Storyboard.TargetProperty="ScaleX" To="0.95" Duration="0:0:0.06"/>
                                            <DoubleAnimation Storyboard.TargetName="pillScale" Storyboard.TargetProperty="ScaleY" To="0.95" Duration="0:0:0.06"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- System Titlebar Button Styles with Smooth Hover & Press Scaling -->
        <Style x:Key="CaptionSysButtonStyle" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="btnScale" ScaleX="1.0" ScaleY="1.0"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource BrushBorder}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource BrushBorderHover}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleX" To="0.92" Duration="0:0:0.06"/>
                                            <DoubleAnimation Storyboard.TargetName="btnScale" Storyboard.TargetProperty="ScaleY" To="0.92" Duration="0:0:0.06"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionSysButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="closeBorder" Background="{TemplateBinding Background}" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="closeScale" ScaleX="1.0" ScaleY="1.0"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="closeBorder" Property="Background" Value="#e81123"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="closeScale" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="closeScale" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="closeScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="closeScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="closeBorder" Property="Background" Value="#b80c1a"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="closeScale" Storyboard.TargetProperty="ScaleX" To="0.92" Duration="0:0:0.06"/>
                                            <DoubleAnimation Storyboard.TargetName="closeScale" Storyboard.TargetProperty="ScaleY" To="0.92" Duration="0:0:0.06"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Upgraded Animated Tactile Glass Button -->
        <!-- Secondary button — flat Geist/shadcn style: hairline surface, background-shift on hover, no shadow/scale. -->
        <Style x:Key="BlackBoxActionBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource BrushCardInnerBg}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="{DynamicResource BrushBorderSubtle}"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="{DynamicResource BrushBorderHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="{DynamicResource BrushCardBg}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bdr" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary accent button — flat Geist/shadcn: solid accent fill, background-shift on hover, no glow/scale. -->
        <Style x:Key="PrimaryActionBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource BrushAccentText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="{DynamicResource BrushAccentLight}"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="{DynamicResource BrushAccentLight}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="{DynamicResource BrushAccentMuted}"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="{DynamicResource BrushAccentMuted}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bdr" Property="BorderBrush" Value="{DynamicResource BrushTextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter pill — flat themed surface, background-shift on hover, no shadow/scale. -->
        <Style x:Key="GlassPillBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,6"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource BrushCardInnerBg}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="pillBdr"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pillBdr" Property="Background" Value="{DynamicResource BrushBorderSubtle}"/>
                                <Setter TargetName="pillBdr" Property="BorderBrush" Value="{DynamicResource BrushBorderHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="pillBdr" Property="Background" Value="{DynamicResource BrushCardBg}"/>
                                <Setter TargetName="pillBdr" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="pillBdr" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Upgraded Sidebar Navigation Button with Smooth Translucent Pill & Subtle Slide -->
        <Style x:Key="SidebarNavBtn" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="navBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="navTrans" X="0"/>
                            </Border.RenderTransform>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="navBorder" Property="Background" Value="{DynamicResource BrushBorderSubtle}"/>
                                <Setter TargetName="navBorder" Property="BorderBrush" Value="{DynamicResource BrushBorderHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="navTrans" Storyboard.TargetProperty="X" To="3" Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="navTrans" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="navBorder" Property="Background" Value="{DynamicResource BrushBorderHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Settings Tab Navigation Button Styles -->
        <Style x:Key="SettingsTabBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="tabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="{DynamicResource BrushBorderSubtle}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="{DynamicResource BrushBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsTabBtnActive" TargetType="Button" BasedOn="{StaticResource SettingsTabBtn}">
            <Setter Property="Background" Value="{DynamicResource BrushBorderSubtle}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderHover}"/>
        </Style>

        <!-- Tiny inline icon button for file-row actions (rename / delete) -->
        <Style x:Key="FileRowIconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource BrushBorder}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource BrushBorderHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Cyber Dark TextBox Style -->
        <Style x:Key="ModernDarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource BrushInputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{DynamicResource BrushAccentLight}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bdr" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dynamic Logo Badge Geometries -->
        <CornerRadius x:Key="ProviderLogoCornerRadius">10</CornerRadius>
        <CornerRadius x:Key="ProviderLogoInnerCornerRadius">8</CornerRadius>
        <CornerRadius x:Key="ProviderLogoSmallCornerRadius">8</CornerRadius>
        <CornerRadius x:Key="ProviderLogoSmallInnerCornerRadius">6</CornerRadius>
        <SolidColorBrush x:Key="LogoBadgeBorderBrush" Color="#26263a"/>

        <!-- ================= MONOCHROME VECTOR ICON GEOMETRIES ================= -->
        <Geometry x:Key="IconHome">M12 3 L3 11 V21 H9 V14 H15 V21 H21 V11 Z</Geometry>
        <Geometry x:Key="IconCube">M12 2 L21 7 V17 L12 22 L3 17 V7 Z M12 2 V22 M3 7 L21 17 M21 7 L3 17</Geometry>
        <Geometry x:Key="IconChart">M4 20 H8 V10 H4 Z M10 20 H14 V4 H10 Z M16 20 H20 V13 H16 Z</Geometry>
        <Geometry x:Key="IconTerminal">M4 7 L9 12 L4 17 L5.5 18.5 L12 12 L5.5 5.5 Z M12 16 H20 V18.5 H12 Z</Geometry>
        <Geometry x:Key="IconFolder">M3 5 H10 L12 7 H21 V19 H3 Z</Geometry>
        <Geometry x:Key="IconSettings">M3 6 H21 V8 H3 Z M3 11 H21 V13 H3 Z M3 16 H21 V18 H3 Z M7 5 H10 V9 H7 Z M14 10 H17 V14 H14 Z M8 15 H11 V19 H8 Z</Geometry>
        <Geometry x:Key="IconSave">M4 3 H16 L20 7 V21 H4 Z M8 3 H14 V8 H8 Z M7 13 H17 V19 H7 Z</Geometry>
        <Geometry x:Key="IconRefresh">M12 5 V2 L7 6 L12 10 V7 A5 5 0 0 1 17 12 H20 A8 8 0 0 0 12 4 Z M12 19 V22 L17 18 L12 14 V17 A5 5 0 0 1 7 12 H4 A8 8 0 0 0 12 20 Z</Geometry>
        <Geometry x:Key="IconFile">M6 2 H14 L20 8 V22 H6 Z M14 2 V8 H20 Z</Geometry>
        <Geometry x:Key="IconPlus">M11 4 H13 V11 H20 V13 H13 V20 H11 V13 H4 V11 H11 Z</Geometry>
        <Geometry x:Key="IconTrash">M9 3 H15 L16 5 H20 V7 H4 V5 H8 Z M6 8 H18 L17 22 H7 Z</Geometry>
        <Geometry x:Key="IconDiff">M3 11 H10 V13 H3 Z M17 8 H19 V11 H22 V13 H19 V16 H17 V13 H14 V11 H17 Z</Geometry>
        <Geometry x:Key="IconImage">M3 5 H21 V19 H3 Z M7 8 A1.6 1.6 0 1 0 10.2 8 A1.6 1.6 0 1 0 7 8 Z</Geometry>
        <Geometry x:Key="IconSearch">M10 3 A7 7 0 1 0 15.3 14.9 L19.7 19.3 L21.1 17.9 L16.7 13.5 A7 7 0 0 0 10 3 Z M10 5 A5 5 0 1 1 10 15 A5 5 0 1 1 10 5 Z</Geometry>
        <Geometry x:Key="IconInfo">M12 2 A10 10 0 1 0 12 22 A10 10 0 1 0 12 2 Z M11 7 H13 V9 H11 Z M11 11 H13 V17 H11 Z</Geometry>
        <Geometry x:Key="IconSend">M2 12 L22 3 L18 21 L12 14 L2 12 Z</Geometry>
        <Geometry x:Key="IconBolt">M13 2 L4 14 H11 L10 22 L20 9 H13 Z</Geometry>
        <Geometry x:Key="IconSwap">M8 3 L4 7 L8 11 V8 H16 V6 H8 Z M16 21 L20 17 L16 13 V16 H8 V18 H16 Z</Geometry>
        <Geometry x:Key="IconCopy">M9 2 H20 V16 H9 Z M4 6 H7 V19 H16 V22 H4 Z</Geometry>
        <Geometry x:Key="IconKey">M14 3 A5 5 0 0 0 9.1 9 L3 15 V18 H6 L7 17 H9 V15 H11 L12.9 13.1 A5 5 0 1 0 14 3 Z M15 6 A1.3 1.3 0 1 1 15 8.6 A1.3 1.3 0 1 1 15 6 Z</Geometry>
    </Window.Resources>

    <!-- Outer Container Border with RootTranslate — true-black OLED base -->
    <Border x:Name="OuterBorder" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Background="{DynamicResource BrushWindowBg}" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TranslateTransform x:Name="RootTranslate" Y="0"/>
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/> <!-- Title Bar -->
                <RowDefinition Height="*"/>  <!-- Dynamic Body Area with Left Dock -->
                <RowDefinition Height="28"/> <!-- Status Bar -->
            </Grid.RowDefinitions>

            <!-- ================= 1. TITLE BAR ================= -->
            <Border Grid.Row="0" Background="{DynamicResource BrushTitleBarBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App Title / Branding + Tiny Top Menu Bar -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Border Width="20" Height="20" Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="5" Margin="0,0,8,0">
                            <Path Data="M 2,6 L 8,2 L 14,6 L 14,14 L 8,18 L 2,14 Z M 2,6 L 8,10 L 14,6 M 8,10 L 8,18"
                                  Stroke="{DynamicResource BrushAccentLight}" StrokeThickness="1.1" Stretch="Uniform" Margin="2"/>
                        </Border>
                        <TextBlock Text="LlmodelBox" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                        <Button x:Name="BtnTopNavChat" Content="Chat" Style="{StaticResource TopMenuBarBtn}" Click="BtnNavChat_Click" ToolTip="Home Chat"/>
                        <Button x:Name="BtnTopNavWorkspace" Content="Workspace" Style="{StaticResource TopMenuBarBtn}" Click="BtnNavHome_Click" ToolTip="Open Project Workspaces"/>
                        <Button x:Name="BtnTopNavModels" Content="Models" Style="{StaticResource TopMenuBarBtn}" Click="BtnNavModelLibrary_Click" ToolTip="Cloud Model Registry"/>
                        <Button x:Name="BtnTopNavUsage" Content="Usage" Style="{StaticResource TopMenuBarBtn}" Click="BtnNavTokenAnalysis_Click" ToolTip="Token Usage"/>
                        <Button x:Name="BtnTopNavNeural" Content="Neural Net" Style="{StaticResource TopMenuBarBtn}" Click="BtnNavNeuralNet_Click" ToolTip="Live Agent Neural Net"/>
                    </StackPanel>

                    <!-- Center Drag Area / Subtle Status -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtHeaderInfo" Text="" FontSize="10.5" Foreground="{DynamicResource BrushTextDim}" FontFamily="Consolas"/>
                    </StackPanel>

                    <!-- System Controls (Minimize, Fullscreen, Close) + Theme Switcher -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- 3-Theme Segmented Pill Switcher -->
                        <Border WindowChrome.IsHitTestVisibleInChrome="True" Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Margin="0,0,10,0" Padding="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnThemeOled" Content="Midnight" Tag="Midnight" Click="BtnThemeSelect_Click" Style="{StaticResource ThemePillBtn}"/>
                                <Button x:Name="BtnThemeMidnight" Content="Slate" Tag="Slate" Click="BtnThemeSelect_Click" Style="{StaticResource ThemePillBtn}" Margin="2,0,0,0"/>
                                <Button x:Name="BtnThemeCarbon" Content="Daylight" Tag="Daylight" Click="BtnThemeSelect_Click" Style="{StaticResource ThemePillBtn}" Margin="2,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Minimize Button -->
                        <Button x:Name="BtnMinimize" 
                                Style="{StaticResource CaptionSysButtonStyle}" 
                                Click="BtnMinimize_Click"
                                ToolTip="Minimize">
                            <Path Data="M 0,0 L 10,0" 
                                  Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                                  StrokeThickness="1" 
                                  SnapsToDevicePixels="True" 
                                  VerticalAlignment="Center"/>
                        </Button>

                        <!-- Fullscreen / Maximize Button -->
                        <Button x:Name="BtnFullscreen" 
                                Style="{StaticResource CaptionSysButtonStyle}" 
                                Click="BtnFullscreen_Click"
                                ToolTip="Toggle Fullscreen / Maximize (F11)">
                            <Grid Width="11" Height="11">
                                <Path x:Name="IconMaximize" 
                                      Data="M 0,0 L 10,0 L 10,10 L 0,10 Z" 
                                      Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                                      StrokeThickness="1" 
                                      Fill="Transparent" 
                                      SnapsToDevicePixels="True"/>
                                <Canvas x:Name="IconRestore" Visibility="Collapsed" Width="11" Height="11">
                                    <Path Data="M 2,0 L 10,0 L 10,8 L 8,8" 
                                          Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                                          StrokeThickness="1" 
                                          Fill="Transparent"/>
                                    <Path Data="M 0,2 L 8,2 L 8,10 L 0,10 Z" 
                                          Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                                          StrokeThickness="1" 
                                          Fill="{DynamicResource BrushCardInnerBg}"/>
                                </Canvas>
                            </Grid>
                        </Button>

                        <!-- Close Button -->
                        <Button x:Name="BtnClose" 
                                Style="{StaticResource CaptionCloseButtonStyle}" 
                                Click="BtnClose_Click"
                                ToolTip="Close Application">
                            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" 
                                  Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                                  StrokeThickness="1" 
                                  SnapsToDevicePixels="True" 
                                  VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= 2. DYNAMIC WORKSPACE WITH ENHANCED LEFT DOCK ================= -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition x:Name="OutputPanelRow" Height="0"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="SidebarColumn" Width="255" MinWidth="240" MaxWidth="270"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ================= CLEAN CONVERSATION SIDEBAR ================= -->
                    <Border Grid.Column="0" Background="{DynamicResource BrushTitleBarBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,1,0">
                    <Grid Margin="10,12,10,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- New Conversation + Quick Links -->
                            <RowDefinition Height="*"/>    <!-- Conversations List -->
                            <RowDefinition Height="Auto"/> <!-- Settings & Profile Footer -->
                        </Grid.RowDefinitions>

                        <!-- Top Action: + New Conversation & Subtle Links -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <Button x:Name="BtnNewConversation" Click="BtnNewConversation_Click" HorizontalContentAlignment="Left" Padding="12,8" Margin="0,0,0,8" Cursor="Hand"
                                    Background="{DynamicResource BrushCardInnerBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="+" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,-1,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="New Conversation" FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bdr" Property="Background" Value="{DynamicResource BrushBorderSubtle}"/>
                                                <Setter TargetName="bdr" Property="BorderBrush" Value="{DynamicResource BrushBorderHover}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Style="{StaticResource SidebarNavBtn}" Padding="10,6" Margin="0,0,0,2" Click="BtnNavHome_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconHome}" Fill="{DynamicResource BrushTextMuted}" Stretch="Uniform" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                    <TextBlock Text="Workspace" FontSize="12" FontWeight="Normal" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarNavBtn}" Padding="10,6" Margin="0,0,0,2" Click="BtnNavModelLibrary_Click">
                                <Grid Width="205">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconCube}" Fill="{DynamicResource BrushTextMuted}" Stretch="Uniform" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                        <TextBlock Text="Models &amp; Keys" FontSize="12" FontWeight="Normal" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtModelCountBadge" Text="484" FontSize="10" Foreground="{DynamicResource BrushTextDim}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </StackPanel>

                        <!-- Conversations List -->
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="6,4,4,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Conversations" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource BrushTextMuted}" Margin="2,0,0,6"/>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0">
                                        <Button x:Name="BtnSidebarProjectFilter" Click="BtnSidebarProjectFilter_Click" HorizontalContentAlignment="Stretch"
                                                Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1"
                                                Padding="8,5" Cursor="Hand" ToolTip="Filter conversations by project">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="fb" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="fb" Property="BorderBrush" Value="{DynamicResource BrushBorderHover}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource IconFolder}" Fill="{DynamicResource BrushAccentLight}" Stretch="Uniform" Width="11" Height="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock x:Name="TxtSidebarProjectFilter" Text="All Projects" FontSize="11.5" Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" MaxWidth="148"/>
                                                </StackPanel>
                                                <TextBlock Text="⌄" FontSize="10" Foreground="{DynamicResource BrushTextDim}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                        <Popup x:Name="SidebarProjectFilterPopup" PlacementTarget="{Binding ElementName=BtnSidebarProjectFilter}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" VerticalOffset="4">
                                            <Border Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="220" MaxHeight="280">
                                                <ListBox x:Name="SidebarProjectFilterList" Background="Transparent" BorderThickness="0" SelectionChanged="SidebarProjectFilterList_SelectionChanged">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" Padding="8,6"/>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                    <Button x:Name="BtnClearProjectFilter" Grid.Column="1" Content="✕" Width="24" Height="24" Margin="4,0,0,0"
                                            Background="Transparent" BorderThickness="0" Foreground="{DynamicResource BrushTextMuted}" FontSize="10"
                                            Cursor="Hand" ToolTip="Show all projects" Visibility="Collapsed" Click="BtnClearProjectFilter_Click"/>
                                </Grid>
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock x:Name="TxtNoConversationsHint" Text="No conversations yet. Start typing on the right."
                                               FontSize="11" Foreground="{DynamicResource BrushTextDim}" TextWrapping="Wrap" Margin="8,8,8,0" Visibility="Collapsed"/>
                                    <ItemsControl x:Name="HomeConversationsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="ConvRow" Background="{Binding RowBackground}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="10,7" Margin="0,0,0,2" Cursor="Hand"
                                                        Tag="{Binding}" MouseLeftButtonUp="HomeConversation_Click">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="{Binding TitleWeight}" Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <Path Data="{StaticResource IconFolder}" Fill="{DynamicResource BrushTextDim}" Stretch="Uniform" Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                                <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Foreground="{DynamicResource BrushTextDim}" TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="6,0,0,0">
                                                            <TextBlock Text="{Binding RelativeTime}" FontSize="10" Foreground="{DynamicResource BrushTextDim}" Margin="0,1,4,0"/>
                                                            <Button Content="✕" Width="16" Height="16" Padding="0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource BrushTextDim}"
                                                                    FontSize="9.5" Cursor="Hand" Tag="{Binding}" Click="BtnDeleteHomeConversation_Click" ToolTip="Delete conversation"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <Trigger SourceName="ConvRow" Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ConvRow" Property="Background" Value="{DynamicResource BrushCardInnerBg}"/>
                                                    </Trigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- Bottom Footer: Settings & Compact Profile -->
                        <StackPanel Grid.Row="2" Margin="0,8,0,0">
                            <Border BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                <StackPanel>
                                    <Button x:Name="BtnSettings" Style="{StaticResource SidebarNavBtn}" Padding="10,7" Margin="0,0,0,4" Click="BtnSettings_Click" ToolTip="Settings &amp; API Keys">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚙" FontSize="13" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                            <TextBlock Text="Settings" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Border x:Name="VisualizeProfileCard" Background="Transparent" CornerRadius="6" Padding="8,4" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="ProfileCardScale" ScaleX="1.0" ScaleY="1.0"/>
                                        </Border.RenderTransform>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource BrushAccent}" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtProfileInitials" Text="AX" FontWeight="Bold" FontSize="9.5" Foreground="{DynamicResource BrushAccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtProfileName" Text="Axion" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock x:Name="TxtActiveGatewayModel" Text="Active: GPT-4o" FontSize="9.5" Foreground="{DynamicResource BrushTextDim}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock x:Name="TxtProfileRole" Text="Online" Visibility="Collapsed"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Style="{StaticResource IdeSplitter}"/>

                <!-- ================= MAIN DYNAMIC CONTENT (RIGHT SIDE) ================= -->
                <Grid Grid.Column="2">
                    <!-- VIEW 0: CLEAN CHAT HOME (DEFAULT STARTUP VIEW) -->
                    <Grid x:Name="ViewChatHome" Visibility="Visible" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="ChatHomeTranslate" Y="0"/>
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Empty / Welcome State -->
                        <StackPanel x:Name="HomeChatEmptyState" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,0,24,10">
                            <Border Width="52" Height="52" HorizontalAlignment="Center" Margin="0,0,0,18" Background="Transparent">
                                <Path Data="M 16,2 L 30,28 L 23,28 L 16,14 L 9,28 L 2,28 Z" Fill="{DynamicResource BrushTextDim}" Opacity="0.45" Stretch="Uniform"/>
                            </Border>
                            <TextBlock x:Name="TxtHomeGreeting" Text="Welcome back. Where should we pick up?"
                                       FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"
                                       HorizontalAlignment="Center" TextAlignment="Center"/>
                            <TextBlock x:Name="TxtHomeGreetingSub" Text="Choose a workspace above or start a general conversation."
                                       FontSize="12.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,8,0,0"
                                       HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="460" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Active Chat Messages Thread -->
                        <ScrollViewer x:Name="HomeChatThreadScroller" Grid.Row="0" Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20,24,10">
                            <StackPanel MaxWidth="780" HorizontalAlignment="Stretch">
                                <ItemsControl x:Name="HomeChatMessagesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,14">
                                                <Border HorizontalAlignment="{Binding Alignment}" MaxWidth="680"
                                                        Background="{Binding BubbleBackground}" BorderBrush="{Binding BubbleBorder}"
                                                        BorderThickness="1" CornerRadius="10" Padding="14,10">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                            <TextBlock Text="{Binding RoleBadgeText}" FontSize="10" FontWeight="Bold" Foreground="{Binding RoleColor}" FontFamily="Consolas"/>
                                                            <TextBlock Text="{Binding Timestamp}" FontSize="10" Foreground="{DynamicResource BrushTextDim}" FontFamily="Consolas" Margin="8,0,0,0"/>
                                                        </StackPanel>
                                                        <RichTextBox common:MarkdownProps.Text="{Binding Content}"
                                                                     IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                                     Padding="0" Margin="0" IsDocumentEnabled="True"
                                                                     Foreground="{DynamicResource BrushTextPrimary}"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border x:Name="HomeThinkingBar" Visibility="Collapsed" HorizontalAlignment="Left"
                                        Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorder}"
                                        BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,4,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource BrushAccent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtHomeThinking" Text="Thinking..." FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" FontFamily="Consolas"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Bottom-Anchored Clean Composer Card -->
                        <Border Grid.Row="1" MaxWidth="760" HorizontalAlignment="Stretch" Margin="28,4,28,26"
                                Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}"
                                BorderThickness="1" CornerRadius="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Top Context Strip: Workspace / Project Selector -->
                                <Border Grid.Row="0" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="12,7">
                                    <StackPanel Orientation="Horizontal">
                                        <Grid>
                                            <Button x:Name="BtnHomeWorkspaceCtx" Click="BtnHomeWorkspaceCtx_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4,2">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource IconFolder}" Fill="{DynamicResource BrushTextMuted}" Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock x:Name="TxtHomeWorkspaceCtx" Text="General Chat" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                                    <TextBlock Text=" ⌄" FontSize="10" Foreground="{DynamicResource BrushTextDim}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Popup x:Name="HomeWorkspacePopup" PlacementTarget="{Binding ElementName=BtnHomeWorkspaceCtx}" Placement="Top" StaysOpen="False" AllowsTransparency="True">
                                                <Border Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="240" MaxHeight="260">
                                                    <ListBox x:Name="HomeWorkspacePickerList" Background="Transparent" BorderThickness="0" SelectionChanged="HomeWorkspacePickerList_SelectionChanged">
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" Padding="8,6"/>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Input Prompt Area -->
                                <Grid Grid.Row="1" Margin="14,10,14,6">
                                    <TextBlock Text="Ask anything, or attach a workspace above..." FontSize="13.5" Foreground="{DynamicResource BrushTextDim}" IsHitTestVisible="False" VerticalAlignment="Top" Margin="2,2,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=TxtHomePrompt}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox x:Name="TxtHomePrompt" Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource BrushTextPrimary}" CaretBrush="{DynamicResource BrushAccentLight}"
                                             FontSize="13.5" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="42" MaxHeight="160"
                                             VerticalScrollBarVisibility="Auto" PreviewKeyDown="TxtHomePrompt_PreviewKeyDown"/>
                                </Grid>

                                <!-- Bottom Composer Bar: Model Picker + Circular Send Button -->
                                <Grid Grid.Row="2" Margin="12,2,12,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <Grid>
                                            <Button x:Name="BtnHomeModelPicker" Click="BtnHomeModelPicker_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6,4">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtHomeModelLabel" Text="GPT-4o" FontSize="11.5" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                                    <TextBlock Text=" ⌄" FontSize="10" Foreground="{DynamicResource BrushTextDim}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Popup x:Name="HomeModelPopup" PlacementTarget="{Binding ElementName=BtnHomeModelPicker}" Placement="Top" StaysOpen="False" AllowsTransparency="True">
                                                <Border Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="280" MaxHeight="340">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Top" Text="SELECT MODEL" FontSize="9.5" FontWeight="Bold" FontFamily="Consolas" Foreground="{DynamicResource BrushTextDim}" Margin="8,6"/>
                                                        <ListBox x:Name="HomeModelPickerList" Background="Transparent" BorderThickness="0" SelectionChanged="HomeModelPickerList_SelectionChanged">
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Margin="6,4">
                                                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                                        <TextBlock Text="{Binding Provider}" FontSize="10" Foreground="{DynamicResource BrushTextDim}"/>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>
                                                    </DockPanel>
                                                </Border>
                                            </Popup>
                                        </Grid>

                                        <Button Content="API Keys" Click="BtnNavApiKeys_Click" Background="Transparent" BorderThickness="0"
                                                Foreground="{DynamicResource BrushTextDim}" FontSize="11" Cursor="Hand" Margin="8,0,0,0" Padding="6,4"/>
                                    </StackPanel>

                                    <Button x:Name="BtnHomeSend" Click="BtnHomeSend_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Width="30" Height="30" Cursor="Hand" ToolTip="Send (Enter)">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="sendBdr" Background="{DynamicResource BrushTextPrimary}" CornerRadius="15">
                                                    <Path Data="M 6,11 L 6,2 M 2,6 L 6,2 L 10,6" Stroke="{DynamicResource BrushWindowBg}" StrokeThickness="1.7"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                          Width="12" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="sendBdr" Property="Opacity" Value="0.88"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="sendBdr" Property="Opacity" Value="0.35"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- VIEW A: HOMEPAGE (PROJECT WORKSPACE PORTAL) -->
                    <Grid x:Name="ViewHomepage" Visibility="Collapsed" Margin="28,22" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="HomepageTranslate" Y="0"/>
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Welcome & Quick Actions Hero -->
                            <RowDefinition Height="*"/>    <!-- Projects Grid -->
                        </Grid.RowDefinitions>

                        <!-- Welcome & Action Cards Section -->
                        <Grid Grid.Row="0" Margin="0,0,0,22">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Workspaces" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Text="Select a project to browse its conversations, start a scoped chat, or launch the IDE." FontSize="12.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12,6">
                                        <TextBlock x:Name="TxtProjectCountBadge" Text="2 Projects Found" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" FontWeight="Medium"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Hero Card 1: Make New Project -->
                                <Border Grid.Column="0" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="18,16" Cursor="Hand"
                                        RenderTransformOrigin="0.5,0.5" MouseLeftButtonUp="CardNewProject_Click">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="42" Height="42" Background="{DynamicResource BrushAccentGlow}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1" CornerRadius="10" VerticalAlignment="Center">
                                            <TextBlock Text="+" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccentLight}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="New Project Workspace" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock Text="Initialize a dedicated project folder with scoped memory &amp; chat history" FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <Button Grid.Column="2" Content="Create" Style="{StaticResource PrimaryActionBtn}" Padding="16,7" VerticalAlignment="Center" Click="BtnOpenNewProjectModal_Click"/>
                                    </Grid>
                                </Border>

                                <!-- Hero Card 2: Open Existing Folder -->
                                <Border Grid.Column="2" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="18,16" Cursor="Hand"
                                        RenderTransformOrigin="0.5,0.5" MouseLeftButtonUp="CardBrowseFolder_Click">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderHover}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="42" Height="42" Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconFolder}" Fill="{DynamicResource BrushTextSecondary}" Stretch="Uniform" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="Open Existing Folder" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock Text="Link any repository on disk to chat with its codebase &amp; files" FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <Button Grid.Column="2" Content="Browse..." Style="{StaticResource BlackBoxActionBtn}" Padding="14,7" VerticalAlignment="Center" Click="BtnBrowseExistingFolder_Click"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- Existing Projects Grid Section -->
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="PROJECT WORKSPACES" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextDim}" Margin="2,0,0,10" FontFamily="Consolas"/>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="ProjectsItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="ProjCard" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="18,15" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Width="44" Height="44" Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10" VerticalAlignment="Center">
                                                        <Path Data="{StaticResource IconCube}" Fill="{DynamicResource BrushAccentLight}" Stretch="Uniform" Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                                            <Border Background="{DynamicResource BrushAccentGlow}" BorderBrush="{DynamicResource BrushAccentMuted}" BorderThickness="1" CornerRadius="999" Margin="10,0,0,0" Padding="8,2" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ConversationSummary}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccentLight}"/>
                                                            </Border>
                                                            <Border Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6" Margin="8,0,0,0" Padding="7,2" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding CreatedAt}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" FontFamily="Consolas"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource BrushTextDim}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" FontFamily="Consolas"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="Chats" Style="{StaticResource PrimaryActionBtn}" Margin="0,0,8,0" Padding="15,7" ToolTip="View project conversation history or start a new chat in this project" Tag="{Binding}" Click="BtnOpenProjectChats_Click"/>
                                                        <Button Content="Open IDE" Style="{StaticResource BlackBoxActionBtn}" Margin="0,0,8,0" Padding="12,7" ToolTip="Open 3-column code editor &amp; tools" Tag="{Binding}" Click="BtnOpenProjectCard_Click"/>
                                                        <Button Content="Folder" Style="{StaticResource BlackBoxActionBtn}" Margin="0,0,8,0" Padding="10,7" Tag="{Binding}" Click="BtnOpenInExplorer_Click"/>
                                                        <Button Content="✕" Style="{StaticResource FileRowIconBtn}" Width="28" Height="28" FontSize="12" ToolTip="Remove project from list" Tag="{Binding}" Click="BtnRemoveProject_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="ProjCard" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ProjCard" Property="BorderBrush" Value="{DynamicResource BrushBorderHover}"/>
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- VIEW B: MODEL LIBRARY (CATEGORIZED BY COMPANY!) -->
                    <Grid x:Name="ViewModelLibrary" Visibility="Collapsed" Margin="22,16" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="ModelLibraryTranslate" Y="0"/>
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Header & Action Banner -->
                            <RowDefinition Height="*"/>    <!-- Company Categories Scrollable List -->
                        </Grid.RowDefinitions>

                        <!-- Header & Actions -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="CLOUD MODEL REGISTRY" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Text="Categorized by Cloud Provider // Real-Time HTTPS API Gateways // Live Dynamic Endpoint Sync" FontSize="12" Foreground="{DynamicResource BrushTextDim}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource BrushInputBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Height="34" Width="230" Margin="0,0,10,0">
                                        <Grid>
                                            <TextBlock Text="🔍 Search models or company..." Foreground="{DynamicResource BrushTextMuted}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=TxtSearchModels}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBox x:Name="TxtSearchModels" Background="Transparent" Foreground="{DynamicResource BrushTextPrimary}" BorderThickness="0" FontSize="12" VerticalAlignment="Center" Padding="10,0" TextChanged="TxtSearchModels_TextChanged"/>
                                        </Grid>
                                    </Border>
                                    <Button Content="🔑 Manage API Keys" Style="{StaticResource PrimaryActionBtn}" Click="BtnOpenApiKeysModal_Click"/>
                                </StackPanel>
                            </Grid>

                            <!-- Quick Filter Pills -->
                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="All Companies" Style="{StaticResource GlassPillBtn}" Margin="0,0,8,0" Padding="13,6" Click="BtnFilterModels_Click" Tag="All"/>
                                    <Button Content="✔ Free" Style="{StaticResource GlassPillBtn}" Margin="0,0,8,0" Padding="13,6" Click="BtnFilterModels_Click" Tag="Free"/>
                                    <Button Content="$ Paid" Style="{StaticResource GlassPillBtn}" Margin="0,0,8,0" Padding="13,6" Click="BtnFilterModels_Click" Tag="Paid"/>
                                    <Border Width="1" Background="{DynamicResource BrushBorderSubtle}" Margin="2,4,10,4"/>
                                    <Button Content="OpenAI" Style="{StaticResource GlassPillBtn}" Margin="0,0,8,0" Padding="13,6" Click="BtnFilterModels_Click" Tag="OpenAI"/>
                                    <Button Content="Anthropic" Style="{StaticResource GlassPillBtn}" Margin="0,0,8,0" Padding="13,6" Click="BtnFilterModels_Click" Tag="Anthropic"/>
                                    <Button Content="Google Gemini" Style="{StaticResource GlassPillBtn}" Margin="0,0,8,0" Padding="13,6" Click="BtnFilterModels_Click" Tag="Google"/>
                                    <Button Content="xAI Grok" Style="{StaticResource GlassPillBtn}" Margin="0,0,8,0" Padding="13,6" Click="BtnFilterModels_Click" Tag="xAI"/>
                                    <Button Content="DeepSeek" Style="{StaticResource GlassPillBtn}" Margin="0,0,8,0" Padding="13,6" Click="BtnFilterModels_Click" Tag="DeepSeek"/>
                                    <Button Content="Groq" Style="{StaticResource GlassPillBtn}" Margin="0,0,8,0" Padding="13,6" Click="BtnFilterModels_Click" Tag="Groq"/>
                                    <Button Content="OpenRouter" Style="{StaticResource GlassPillBtn}" Margin="0,0,8,0" Padding="13,6" Click="BtnFilterModels_Click" Tag="OpenRouter"/>
                                    <Button Content="Mistral AI" Style="{StaticResource GlassPillBtn}" Margin="0,0,8,0" Padding="13,6" Click="BtnFilterModels_Click" Tag="Mistral"/>
                                    <Button Content="⚡ Custom Providers" Style="{StaticResource GlassPillBtn}" Padding="13,6" Click="BtnFilterModels_Click" Tag="Custom"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- Company Categories — ListBox IS the scroller so the VirtualizingStackPanel
                             actually virtualizes (a wrapping ScrollViewer gives infinite height and
                             defeats virtualization, which was the real cause of the load lag). -->
                        <ListBox Grid.Row="1" x:Name="CompanyCategoriesControl"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 ScrollViewer.CanContentScroll="True"
                                 HorizontalContentAlignment="Stretch">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Focusable" Value="False"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="12" Margin="0,0,0,16" Padding="18,16">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="3" BlurRadius="16" Opacity="0.35"/>
                                            </Border.Effect>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/> <!-- Company Header -->
                                                    <RowDefinition Height="Auto"/> <!-- Divider -->
                                                    <RowDefinition Height="*"/>    <!-- Models in this Company -->
                                                </Grid.RowDefinitions>

                                                <!-- Company Header -->
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/> <!-- Logo -->
                                                        <ColumnDefinition Width="*"/>    <!-- Info -->
                                                        <ColumnDefinition Width="Auto"/> <!-- Status & Action -->
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Company Logo (Clean: No Emoji Overlay) -->
                                                    <Border Grid.Column="0" Width="46" Height="46" Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1.5" CornerRadius="{DynamicResource ProviderLogoCornerRadius}" VerticalAlignment="Center" Margin="0,0,14,0" SnapsToDevicePixels="True">
                                                        <Border CornerRadius="{DynamicResource ProviderLogoInnerCornerRadius}">
                                                            <Border.OpacityMask>
                                                                <VisualBrush Stretch="Fill">
                                                                    <VisualBrush.Visual>
                                                                        <Border Background="Black" CornerRadius="{DynamicResource ProviderLogoInnerCornerRadius}" Width="46" Height="46"/>
                                                                    </VisualBrush.Visual>
                                                                </VisualBrush>
                                                            </Border.OpacityMask>
                                                            <Grid>
                                                                <TextBlock Text="{Binding FallbackIcon}" Visibility="{Binding FallbackIconVisibility}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                <Image Source="{Binding LocalLogoPath}" Visibility="{Binding LogoVisibility}" Stretch="Uniform" Margin="4" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            </Grid>
                                                        </Border>
                                                    </Border>

                                                    <!-- Company Metadata -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource BrushTextPrimary}"/>
                                                            <Border Background="{DynamicResource BrushBorderSubtle}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6" Margin="10,0,0,0" Padding="8,2">
                                                                <TextBlock Text="{Binding ModelCount, StringFormat='{}{0} Models Available'}" FontSize="10" Foreground="{DynamicResource BrushAccentLight}" FontFamily="Consolas"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Tagline}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                            <TextBlock Text="Console / API Docs: " FontSize="10" Foreground="{DynamicResource BrushTextDim}" FontFamily="Consolas"/>
                                                            <TextBlock Text="{Binding WebUrl}" FontSize="10" Foreground="{DynamicResource BrushAccentLight}" FontFamily="Consolas"/>
                                                            <TextBlock Text="  |  Env Var: " FontSize="10" Foreground="{DynamicResource BrushTextDim}" FontFamily="Consolas" Margin="8,0,0,0"/>
                                                            <TextBlock Text="{Binding EnvVarName}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" FontFamily="Consolas"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Company Key Status & Action Buttons -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Background="{Binding KeyStatusBadgeBg}" BorderBrush="{Binding KeyStatusBorder}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,10,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding KeyStatusBadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding KeyStatusBadgeColor}" FontFamily="Consolas"/>
                                                        </Border>
                                                        <Button Content="{Binding ActionBtnText}" Style="{StaticResource BlackBoxActionBtn}" Tag="{Binding}" Click="BtnConfigureCompanyKey_Click" Margin="0,0,8,0"/>
                                                        <Button Content="⚡ Test" Style="{StaticResource BlackBoxActionBtn}" Tag="{Binding}" Click="BtnTestCompanyConnection_Click"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Divider -->
                                                <Border Grid.Row="1" Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="0,12,0,12"/>

                                                <!-- Models inside this Company (virtualized: large catalogs like OpenRouter render lazily) -->
                                                <ScrollViewer Grid.Row="2" MaxHeight="640" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                                                <ItemsControl ItemsSource="{Binding Models}"
                                                              VirtualizingStackPanel.IsVirtualizing="True"
                                                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                                                              ScrollViewer.CanContentScroll="True">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <VirtualizingStackPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,10">
                                                                <Border.Effect>
                                                                    <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.2"/>
                                                                </Border.Effect>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- Accent spine -->
                                                                    <Border Grid.Column="0" Width="3" CornerRadius="2" Background="{DynamicResource BrushAccent}" Margin="0,1,14,1"/>

                                                                    <StackPanel Grid.Column="1">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                                                            <Border Background="{Binding TierBadgeBg}" CornerRadius="4" Margin="8,0,0,0" Padding="7,2" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding TierBadgeText}" FontSize="9" FontWeight="Bold" Foreground="{Binding TierBadgeColor}" FontFamily="Consolas"/>
                                                                            </Border>
                                                                            <Border Background="{DynamicResource BrushBorderSubtle}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="4" Margin="6,0,0,0" Padding="7,2" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding Family}" FontSize="10" Foreground="{DynamicResource BrushTextSecondary}" FontFamily="Consolas"/>
                                                                            </Border>
                                                                            <Border Background="{Binding KeyBadgeBg}" CornerRadius="4" Margin="6,0,0,0" Padding="7,2" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding KeyBadgeText}" FontSize="10" FontWeight="Bold" Foreground="{Binding KeyBadgeColor}" FontFamily="Consolas"/>
                                                                            </Border>
                                                                        </StackPanel>
                                                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                                            <Border Background="{DynamicResource BrushBorderSubtle}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="0,0,7,0">
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <TextBlock Text="CTX " FontSize="9" Foreground="{DynamicResource BrushTextDim}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                                                    <TextBlock Text="{Binding Context}" FontSize="10" Foreground="{DynamicResource BrushAccentLight}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                                                </StackPanel>
                                                                            </Border>
                                                                            <Border Background="{DynamicResource BrushBorderSubtle}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="0,0,7,0">
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <TextBlock Text="PRICE " FontSize="9" Foreground="{DynamicResource BrushTextDim}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                                                    <TextBlock Text="{Binding Pricing}" FontSize="10" Foreground="{DynamicResource BrushTextPrimary}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                                                </StackPanel>
                                                                            </Border>
                                                                            <Border Background="{DynamicResource BrushBorderSubtle}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="7,2">
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <TextBlock Text="FMT " FontSize="9" Foreground="{DynamicResource BrushTextDim}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                                                    <TextBlock Text="{Binding Format}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </StackPanel>
                                                                    </StackPanel>

                                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                                        <Button Content="{Binding ActionBtnText}" Style="{StaticResource PrimaryActionBtn}" Tag="{Binding}" Click="BtnChatModel_Click"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                </ScrollViewer>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                    </Grid>

                    <!-- VIEW: TOKEN ANALYSIS (top-level page) -->
                    <Grid x:Name="ViewTokenUsage" Visibility="Collapsed" Margin="22,16" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="TokenUsageTranslate" Y="0"/>
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="Token Analysis" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                            <TextBlock Text="Prompt &amp; completion tokens tracked across every model call." FontSize="12" Foreground="{DynamicResource BrushTextMuted}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <!-- Empty state -->
                            <StackPanel x:Name="UsageEmptyState" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="📊" FontSize="40" HorizontalAlignment="Center" Opacity="0.5"/>
                                <TextBlock Text="No token usage recorded yet" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                <TextBlock Text="Start a chat with any model — prompt &amp; completion tokens are tracked here automatically." FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" Margin="0,6,0,0" TextAlignment="Center" MaxWidth="360" TextWrapping="Wrap"/>
                            </StackPanel>

                            <ScrollViewer x:Name="UsageContentPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <!-- KPI row -->
                                    <UniformGrid x:Name="UsageKpiPanel" Rows="1" Columns="6" Margin="0,0,0,16">
                                        <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,10,0">
                                            <StackPanel>
                                                <TextBlock Text="TOTAL TOKENS" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" FontFamily="Consolas"/>
                                                <TextBlock x:Name="UsageKpiTotal" Text="0" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,10,0">
                                            <StackPanel>
                                                <TextBlock Text="MODEL CALLS" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" FontFamily="Consolas"/>
                                                <TextBlock x:Name="UsageKpiCalls" Text="0" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,10,0">
                                            <StackPanel>
                                                <TextBlock Text="PROMPT (IN)" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" FontFamily="Consolas"/>
                                                <TextBlock x:Name="UsageKpiPrompt" Text="0" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,10,0">
                                            <StackPanel>
                                                <TextBlock Text="COMPLETION (OUT)" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" FontFamily="Consolas"/>
                                                <TextBlock x:Name="UsageKpiCompletion" Text="0" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,10,0">
                                            <StackPanel>
                                                <TextBlock Text="AVG LATENCY" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" FontFamily="Consolas"/>
                                                <TextBlock x:Name="UsageKpiLatency" Text="—" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource BrushWarning}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                                            <StackPanel>
                                                <TextBlock Text="AVG THROUGHPUT" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" FontFamily="Consolas"/>
                                                <TextBlock x:Name="UsageKpiThroughput" Text="—" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource BrushSuccess}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <!-- 14-day activity -->
                                    <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="18,16" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="ACTIVITY · LAST 14 DAYS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" FontFamily="Consolas" Margin="0,0,0,14"/>
                                            <StackPanel x:Name="UsageDayBars" Orientation="Horizontal" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Border>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- By provider -->
                                        <Border Grid.Column="0" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="18,16">
                                            <StackPanel>
                                                <TextBlock Text="TOKENS BY PROVIDER" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" FontFamily="Consolas" Margin="0,0,0,14"/>
                                                <StackPanel x:Name="UsageProviderBars"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Top models -->
                                        <Border Grid.Column="2" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="18,16">
                                            <StackPanel>
                                                <TextBlock Text="TOP MODELS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" FontFamily="Consolas" Margin="0,0,0,14"/>
                                                <StackPanel x:Name="UsageModelBars"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Per-model performance graph: latency + throughput -->
                                    <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="18,16" Margin="0,0,0,16">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,14">
                                                <TextBlock Text="MODEL PERFORMANCE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Border Width="9" Height="9" CornerRadius="2" Background="{DynamicResource BrushWarning}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="latency" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource BrushTextMuted}" Margin="5,0,14,0" VerticalAlignment="Center"/>
                                                    <Border Width="9" Height="9" CornerRadius="2" Background="{DynamicResource BrushSuccess}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="tokens/sec" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource BrushTextMuted}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel x:Name="UsagePerfBars"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Advanced insights + hour-of-day activity -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="1.4*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="18,16">
                                            <StackPanel>
                                                <TextBlock Text="ADVANCED INSIGHTS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" FontFamily="Consolas" Margin="0,0,0,14"/>
                                                <StackPanel x:Name="UsageInsightsPanel"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="18,16">
                                            <StackPanel>
                                                <TextBlock Text="HOUR-OF-DAY ACTIVITY (UTC)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" FontFamily="Consolas" Margin="0,0,0,14"/>
                                                <StackPanel x:Name="UsageHourBars" Orientation="Horizontal" HorizontalAlignment="Left"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Button Content="Clear usage history" Style="{StaticResource BlackBoxActionBtn}" HorizontalAlignment="Left" Padding="12,6" Click="BtnClearTokenUsage_Click"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- VIEW: NEURAL NET (agent introspection) -->
                    <Grid x:Name="ViewNeuralNet" Visibility="Collapsed" Margin="22,16" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="NeuralNetTranslate" Y="0"/>
                        </Grid.RenderTransform>
                        <controls:NeuralNetVisualizer x:Name="NeuralNetView"/>
                    </Grid>

                    <!-- VIEW C: ACTIVE PROJECT WORKSPACE (3-COLUMN IDE COCKPIT) -->
                    <ContentControl x:Name="ViewProjectWorkspace" Visibility="Collapsed" Margin="14,10" RenderTransformOrigin="0.5,0.5">
                        <ContentControl.RenderTransform>
                            <TranslateTransform x:Name="WorkspaceTranslate" Y="0"/>
                        </ContentControl.RenderTransform>
                    </ContentControl>
                    <TextBox x:Name="TxtTerminalOutput" Visibility="Collapsed"/>
                    <TextBox x:Name="TxtInputPrompt" Visibility="Collapsed"/>
                </Grid>
                </Grid>

                <!-- ================= SHELL OUTPUT SPLITTER ================= -->
                <GridSplitter Grid.Row="1" x:Name="OutputSplitter" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" ResizeDirection="Rows" Style="{StaticResource IdeSplitter}" Visibility="Collapsed"/>

                <!-- ================= SHELL OUTPUT / TERMINAL PANEL ================= -->
                <Border Grid.Row="2" x:Name="OutputPanel" Background="{DynamicResource BrushTitleBarBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0" Visibility="Collapsed">
                    <Grid Margin="12,8,12,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Style="{StaticResource IdeSectionHeader}" Text="OUTPUT / TERMINAL"/>
                            <Button HorizontalAlignment="Right" Style="{StaticResource IdeIconButton}" Content="&#10005;" FontSize="11" ToolTip="Hide output panel" Click="BtnToggleOutput_Click"/>
                        </Grid>
                        <Border Grid.Row="1" Style="{StaticResource IdeCard}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10,8">
                                <TextBlock x:Name="TxtShellOutput" Text="[OUTPUT] Shell terminal ready." FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>

                <!-- ================= MODAL OVERLAY 1: CREATE NEW PROJECT ================= -->
                <Grid x:Name="ModalNewProject" Visibility="Collapsed" Background="#aa040406" Grid.ColumnSpan="2" Grid.RowSpan="3" Panel.ZIndex="50">
                    <Border x:Name="ModalBox" Width="580" Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="26"
                            HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="34" ShadowDepth="0" Opacity="0.6"/>
                        </Border.Effect>
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="ModalScale" ScaleX="1.0" ScaleY="1.0"/>
                        </Border.RenderTransform>
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="CREATE NEW PROJECT" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Text="Initialize a model workspace with custom folder and parameters" FontSize="12" Foreground="{DynamicResource BrushTextDim}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Content="✕" Style="{StaticResource CaptionSysButtonStyle}" Width="32" Height="32" HorizontalAlignment="Right" Click="BtnCancelNewProject_Click"/>
                            </Grid>

                            <TextBlock Text="Project Name (Suggested or Custom):" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,8,0">
                                    <TextBox x:Name="TxtNewProjectName" Background="Transparent" Foreground="{DynamicResource BrushTextPrimary}" BorderThickness="0" FontSize="13" FontFamily="Consolas, Segoe UI"/>
                                </Border>
                                <Button Grid.Column="1" Content="🎲 Name" Style="{StaticResource BlackBoxActionBtn}" Margin="0,0,8,0" Click="BtnGenerateSuggestion_Click"/>
                                <Button Grid.Column="2" x:Name="BtnAiIdea" Content="💡 AI Idea" Style="{StaticResource PrimaryActionBtn}" Click="BtnAiIdea_Click"/>
                            </Grid>

                            <!-- AI-generated project ideas -->
                            <Border x:Name="IdeasPanel" Visibility="Collapsed" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,20,14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="💡 AI PROJECT IDEAS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccentLight}" FontFamily="Consolas"/>
                                        <TextBlock x:Name="TxtIdeasStatus" Text="" FontSize="10" Foreground="{DynamicResource BrushTextDim}" FontFamily="Consolas" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ItemsControl x:Name="IdeasList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,7">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                                                <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="4" Margin="8,0,0,0" Padding="7,2" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding StackBadge}" FontSize="9" Foreground="{DynamicResource BrushAccentLight}" FontFamily="Consolas"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="Use →" Style="{StaticResource BlackBoxActionBtn}" Padding="10,5" Margin="10,0,0,0" VerticalAlignment="Center" Tag="{Binding}" Click="BtnUseIdea_Click"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Custom Folder Path:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,8,0">
                                    <TextBox x:Name="TxtNewProjectPath" Background="Transparent" Foreground="{DynamicResource BrushAccentLight}" BorderThickness="0" FontSize="12" FontFamily="Consolas, Segoe UI"/>
                                </Border>
                                <Button Grid.Column="1" Content="📁 Choose Folder..." Style="{StaticResource PrimaryActionBtn}" Click="BtnBrowseCustomFolder_Click"/>
                            </Grid>

                            <TextBlock Text="Description (Optional):" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,6"/>
                            <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,20,0">
                                <TextBox x:Name="TxtNewProjectDesc" Background="Transparent" Foreground="{DynamicResource BrushTextPrimary}" BorderThickness="0" FontSize="13" Text="Custom LLM and Neural Pipeline Sandbox"/>
                            </Border>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel" Style="{StaticResource BlackBoxActionBtn}" Margin="0,0,8,0" Click="BtnCancelNewProject_Click"/>
                                <Button Content="Create &amp; Launch Project" Style="{StaticResource PrimaryActionBtn}" Click="BtnCreateProjectConfirm_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ================= MODAL OVERLAY 2: LLMODELBOX SETTINGS & PROVIDER STUDIO ================= -->
                <Grid x:Name="ModalSettings" Visibility="Collapsed" Background="#bb030306" Grid.ColumnSpan="2" Grid.RowSpan="3" Panel.ZIndex="60">
                    <Border x:Name="SettingsModalBox" Width="840" Height="660" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="12" Padding="24,20"
                            HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="36" ShadowDepth="0" Opacity="0.65"/>
                        </Border.Effect>
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="SettingsModalScale" ScaleX="1.0" ScaleY="1.0"/>
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Title Header -->
                                <RowDefinition Height="Auto"/> <!-- Tab Navigation Bar -->
                                <RowDefinition Height="*"/>    <!-- Active Tab Content Area -->
                                <RowDefinition Height="Auto"/> <!-- Bottom Actions Bar -->
                            </Grid.RowDefinitions>

                            <!-- Modal Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
