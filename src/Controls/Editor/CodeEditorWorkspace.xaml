<UserControl x:Class="LlmodelBox.Controls.Editor.CodeEditorWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Focusable="True"
             PreviewKeyDown="UserControl_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Row 0: Open File Tabs + Action Toolbar -->
            <RowDefinition Height="Auto"/> <!-- Row 1: AI Inline Change Preview Banner -->
            <RowDefinition Height="*"/>    <!-- Row 2: AvalonEdit + Floating Overlays (Find/Replace, Go To Line) -->
            <RowDefinition Height="Auto"/> <!-- Row 3: Editor Status Bar -->
        </Grid.RowDefinitions>

        <!-- ================= ROW 0: MULTI-TAB STRIP + ACTION TOOLBAR ================= -->
        <Border Grid.Row="0" Background="{DynamicResource BrushGlassHeader}" BorderThickness="0" CornerRadius="14,14,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="34"/>
                </Grid.RowDefinitions>

                <!-- Tab Strip -->
                <Grid Grid.Row="0" Background="Transparent" Margin="10,4,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="EditorTabsPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                    </ScrollViewer>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                        <Border x:Name="DirtyStatusPill" Background="{DynamicResource BrushSuccessGlow}" BorderThickness="0" CornerRadius="999" Padding="9,2.5" Margin="0,0,4,0">
                            <TextBlock x:Name="TxtEditorStatus" Text="✓ Saved" Foreground="{DynamicResource BrushSuccess}" FontSize="9.5" FontWeight="SemiBold" FontFamily="Consolas"/>
                        </Border>
                        <TextBlock x:Name="TxtActiveFileName" Text="(no file)" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>

                <!-- Action Toolbar (Borderless Ghost Buttons) -->
                <Border Grid.Row="1" BorderThickness="0" Padding="10,0">
                    <Grid VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource PrimaryActionBtn}" Padding="10,3.5" Margin="0,0,6,0" FontSize="10.5" Click="BtnSave_Click" ToolTip="Save Active File (Ctrl+S)">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconSave}" Fill="{DynamicResource BrushAccentText}" Stretch="Uniform" Width="11.5" Height="11.5" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="Save" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnUndo" Content="↶ Undo" Style="{StaticResource GhostToolBtn}" Padding="8,3.5" Margin="0,0,3,0" FontSize="10.5" Click="BtnUndo_Click" ToolTip="Undo (Ctrl+Z)"/>
                            <Button x:Name="BtnRedo" Content="↷ Redo" Style="{StaticResource GhostToolBtn}" Padding="8,3.5" Margin="0,0,3,0" FontSize="10.5" Click="BtnRedo_Click" ToolTip="Redo (Ctrl+Y)"/>
                            <Button Content="Find" Style="{StaticResource GhostToolBtn}" Padding="8,3.5" Margin="0,0,3,0" FontSize="10.5" Click="BtnToggleFind_Click" ToolTip="Find &amp; Replace (Ctrl+F / Ctrl+H)"/>
                            <Button Content="Ln #" Style="{StaticResource GhostToolBtn}" Padding="8,3.5" Margin="0,0,3,0" FontSize="10.5" Click="BtnToggleGoToLine_Click" ToolTip="Go to Line (Ctrl+G)"/>
                            <Button Content="Fold" Style="{StaticResource GhostToolBtn}" Padding="8,3.5" Margin="0,0,3,0" FontSize="10.5" Click="BtnFoldToggle_Click" ToolTip="Collapse / Expand Code Folds"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource GhostToolBtn}" Padding="8,3.5" Margin="0,0,4,0" FontSize="10.5" Click="BtnDiff_Click" ToolTip="Review unsaved &amp; project diffs">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconDiff}" Fill="{DynamicResource BrushTextSecondary}" Stretch="Uniform" Width="11.5" Height="11.5" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="Diff" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostToolBtn}" Padding="8,3.5" FontSize="10.5" Click="BtnCopy_Click" ToolTip="Copy active buffer to clipboard">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconCopy}" Fill="{DynamicResource BrushTextSecondary}" Stretch="Uniform" Width="11.5" Height="11.5" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="Copy" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ================= ROW 1: AI-GENERATED INLINE CHANGE PREVIEW BANNER ================= -->
        <Border x:Name="AiInlinePreviewBanner" Grid.Row="1" Visibility="Collapsed"
                Background="{DynamicResource BrushAccentGlow}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="0,0,0,1" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource BrushSuccessGlow}" BorderBrush="{DynamicResource BrushSuccess}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,8,0">
                        <TextBlock x:Name="TxtAiProposalDelta" Text="+0 -0" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushSuccess}"/>
                    </Border>
                    <TextBlock Text="AI inline edit preview — modified lines highlighted in green" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Accept AI" Style="{StaticResource PrimaryActionBtn}" Padding="9,3" FontSize="10" Margin="0,0,5,0" Click="BtnAcceptAiProposal_Click"/>
                    <Button Content="Reject / Revert" Style="{StaticResource BlackBoxActionBtn}" Padding="9,3" FontSize="10" Click="BtnRejectAiProposal_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= ROW 2: AVALONEDIT CODE HOST + FLOATING OVERLAYS ================= -->
        <Grid Grid.Row="2">
            <!-- Do NOT wrap AvalonEdit inside ScrollViewer so native line virtualization stays fast -->
            <avalon:TextEditor x:Name="AvalonEditor"
                               Background="Transparent"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               LineNumbersForeground="{DynamicResource BrushTextDim}"
                               FontFamily="Cascadia Code, Consolas, Courier New"
                               FontSize="12.5"
                               ShowLineNumbers="True"
                               WordWrap="False"
                               HorizontalScrollBarVisibility="Auto"
                               VerticalScrollBarVisibility="Auto"
                               Padding="8,8,10,8"/>

            <!-- Floating Find & Replace Panel (Top Right) -->
            <Border x:Name="FindReplaceOverlay" Visibility="Collapsed"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,18,0" Width="340"
                    Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorderHover}" BorderThickness="1" CornerRadius="10" Padding="9,8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.45" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="7,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtFindQuery" Grid.Column="0" Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource BrushTextPrimary}" CaretBrush="{DynamicResource BrushAccentLight}"
                                         FontFamily="Consolas" FontSize="11" TextChanged="TxtFindQuery_TextChanged" KeyDown="TxtFindQuery_KeyDown"/>
                                <TextBlock x:Name="TxtFindCount" Grid.Column="1" Text="0/0" FontFamily="Consolas" FontSize="9.5" Foreground="{DynamicResource BrushTextDim}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0">
                            <ToggleButton x:Name="TglMatchCase" Content="Aa" ToolTip="Match Case" FontFamily="Consolas" FontSize="9.5" Padding="5,3" Margin="0,0,2,0" Checked="SearchOption_Changed" Unchecked="SearchOption_Changed"/>
                            <ToggleButton x:Name="TglWholeWord" Content="\b" ToolTip="Whole Word" FontFamily="Consolas" FontSize="9.5" Padding="5,3" Margin="0,0,2,0" Checked="SearchOption_Changed" Unchecked="SearchOption_Changed"/>
                            <ToggleButton x:Name="TglRegex" Content=".*" ToolTip="Regular Expression" FontFamily="Consolas" FontSize="9.5" Padding="5,3" Margin="0,0,4,0" Checked="SearchOption_Changed" Unchecked="SearchOption_Changed"/>
                            <Button Content="↑" ToolTip="Previous Match" Style="{StaticResource IdeIconButton}" Width="22" Height="22" Click="BtnFindPrev_Click"/>
                            <Button Content="↓" ToolTip="Next Match" Style="{StaticResource IdeIconButton}" Width="22" Height="22" Margin="2,0,0,0" Click="BtnFindNext_Click"/>
                            <Button Content="✕" ToolTip="Close (Esc)" Style="{StaticResource IdeIconButton}" Width="22" Height="22" Margin="2,0,0,0" Click="BtnCloseFind_Click"/>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="ReplaceRow" Visibility="Visible">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="7,4">
                            <TextBox x:Name="TxtReplaceWith" Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource BrushTextPrimary}" CaretBrush="{DynamicResource BrushAccentLight}"
                                     FontFamily="Consolas" FontSize="11" ToolTip="Replace with..."/>
                        </Border>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0">
                            <Button Content="Replace" Style="{StaticResource BlackBoxActionBtn}" Padding="7,4" FontSize="9.5" Margin="0,0,3,0" Click="BtnReplaceOne_Click"/>
                            <Button Content="All" Style="{StaticResource PrimaryActionBtn}" Padding="8,4" FontSize="9.5" Click="BtnReplaceAll_Click"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Floating Go-To-Line Overlay (Top Center) -->
            <Border x:Name="GoToLineOverlay" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0" Width="260"
                    Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1" CornerRadius="10" Padding="9,7">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="4" Opacity="0.4" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Go to Line:" FontSize="10.5" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <Border Grid.Column="1" Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="6,3">
                        <TextBox x:Name="TxtGoToLineInput" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource BrushTextPrimary}"
                                 CaretBrush="{DynamicResource BrushAccentLight}" FontFamily="Consolas" FontSize="11" ToolTip="line or line:col" KeyDown="TxtGoToLineInput_KeyDown"/>
                    </Border>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="5,0,0,0">
                        <Button Content="Jump" Style="{StaticResource PrimaryActionBtn}" Padding="8,3" FontSize="9.5" Margin="0,0,3,0" Click="BtnJumpToLine_Click"/>
                        <Button Content="✕" Style="{StaticResource IdeIconButton}" Width="22" Height="22" Click="BtnCloseGoToLine_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Non-Blocking Async File Loading Pill -->
            <Border x:Name="LoadingPillOverlay" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1" CornerRadius="999" Padding="14,7">
                <TextBlock Text="Loading file asynchronously…" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource BrushAccentLight}"/>
            </Border>
        </Grid>

        <!-- ================= ROW 3: EDITOR TELEMETRY & DIAGNOSTICS BAR ================= -->
        <Border Grid.Row="3" Background="{DynamicResource BrushGlassHeader}" BorderThickness="0" CornerRadius="0,0,14,14" Padding="12,6">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnDiagnosticsBadge" Background="Transparent" BorderThickness="0" Padding="4,1" Cursor="Hand" Click="BtnDiagnosticsBadge_Click" ToolTip="Click to jump to next diagnostic">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DiagStatusDot" Width="6.5" Height="6.5" Fill="{DynamicResource BrushSuccess}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtDiagnosticsSummary" Text="0 Errors · 0 Warnings" FontFamily="Consolas" FontSize="9.5" Foreground="{DynamicResource BrushTextSecondary}"/>
                        </StackPanel>
                    </Button>
                    <Border Background="{DynamicResource BrushHoverTint}" Width="1" Height="11" Margin="8,0"/>
                    <TextBlock x:Name="TxtLargeFileNotice" Visibility="Collapsed" Text="Large File Safe Mode" FontFamily="Consolas" FontSize="9.5" Foreground="{DynamicResource BrushWarning}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtDiagnosticActiveMsg" Text="" FontSize="9.5" Foreground="{DynamicResource BrushTextDim}" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Background="Transparent" BorderThickness="0" Padding="4,1" Cursor="Hand" Click="BtnToggleGoToLine_Click" ToolTip="Click to Go to Line (Ctrl+G)">
                        <TextBlock x:Name="TxtCursorPosition" Text="Ln 1, Col 1" FontFamily="Consolas" FontSize="9.5" Foreground="{DynamicResource BrushTextSecondary}"/>
                    </Button>
                    <Border Background="{DynamicResource BrushHoverTint}" Width="1" Height="11" Margin="8,0"/>
                    <TextBlock x:Name="TxtEditorEncoding" Text="UTF-8" FontFamily="Consolas" FontSize="9.5" Foreground="{DynamicResource BrushTextDim}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource BrushHoverTint}" Width="1" Height="11" Margin="8,0"/>
                    <Border x:Name="EditorLanguagePill" Background="{DynamicResource BrushCardInnerBg}" BorderThickness="0" CornerRadius="6" Padding="8,2">
                        <TextBlock x:Name="TxtEditorLanguage" Text="Plain Text" FontFamily="Consolas" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccentLight}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
