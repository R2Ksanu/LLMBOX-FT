<UserControl x:Class="LlmodelBox.Controls.NeuralNetVisualizer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:LlmodelBox.Controls"
             d:DesignHeight="640" d:DesignWidth="1100">
    <Grid Background="{DynamicResource BrushWindowBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="4,0,4,14">
            <StackPanel>
                <TextBlock Text="NEURAL NET" FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                           Foreground="{DynamicResource BrushAccentLight}"/>
                <TextBlock Text="Live view of the agent's inner activity — every prompt, memory load, model call, reasoning burst, context compaction and token settle lights up as it happens."
                           FontSize="12" Foreground="{DynamicResource BrushTextMuted}" TextWrapping="Wrap" MaxWidth="820" HorizontalAlignment="Left" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="PulseDot" Width="9" Height="9" Fill="{DynamicResource BrushSuccess}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock x:Name="TxtState" Text="idle" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                    <TextBlock x:Name="TxtSignalCount" Text="0 signals" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                </Border>
                <Button x:Name="BtnToggle3D" Content="3D" Click="BtnToggle3D_Click"
                        Style="{StaticResource BlackBoxActionBtn}" Padding="12,6" Margin="0,0,8,0"/>
                <Button x:Name="BtnClearNeural" Content="Clear" Click="BtnClearNeural_Click"
                        Style="{StaticResource BlackBoxActionBtn}" Padding="12,6"/>
            </StackPanel>
        </Grid>

        <!-- Body: graph + event log -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                <Grid>
                    <Viewbox x:Name="Graph2DHost" Stretch="Uniform" Margin="12">
                        <Canvas x:Name="BrainCanvas" Width="960" Height="540"/>
                    </Viewbox>
                    <local:NeuralNet3DVisualizer x:Name="Graph3DHost" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" Margin="14,0,0,0" Background="{DynamicResource BrushCardBg}"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="SIGNAL STREAM" FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextDim}" Margin="0,0,0,10"/>
                    <ScrollViewer Grid.Row="1" x:Name="LogScroller" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="SignalLog"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
