<UserControl x:Class="LlmodelBox.Controls.WorkspaceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LlmodelBox"
             xmlns:rich="clr-namespace:LlmodelBox.Controls.RichChat"
             xmlns:utility="clr-namespace:LlmodelBox.Controls.UtilityPanel"
             xmlns:editor="clr-namespace:LlmodelBox.Controls.Editor"
             xmlns:common="clr-namespace:LlmodelBox.Common"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Workspace Header -->
                            <RowDefinition Height="*"/>    <!-- 3-Column IDE Workspace Grid -->
                        </Grid.RowDefinitions>

                        <!-- Workspace Translucent Glass Header Bar -->
                        <Border Grid.Row="0" Style="{StaticResource GlassPanelSurface}" Padding="14,8" Margin="8,8,8,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Content="← Back to Projects" Style="{StaticResource BlackBoxActionBtn}" Click="BtnBackToProjects_Click" Margin="0,0,14,0"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtActiveProjectName" Text="Alpha-Project" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" FontSize="14"/>
                                        <Border Background="{DynamicResource BrushSuccessGlow}" BorderBrush="{DynamicResource BrushSuccess}" BorderThickness="1" CornerRadius="3" Margin="8,0,0,0" Padding="6,1">
                                            <TextBlock Text="ACTIVE WORKSPACE" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BrushSuccess}"/>
                                        </Border>
                                        <Border Background="{DynamicResource BrushAccentGlow}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1" CornerRadius="3" Margin="8,0,0,0" Padding="6,1">
                                            <TextBlock x:Name="TxtTerminalActiveModel" Text="[API: GPT-4o]" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushAccentLight}" FontFamily="Consolas"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtActiveProjectPath" Text="G:\tools\LlmodelBox\projects\Alpha" Foreground="{DynamicResource BrushTextDim}" FontSize="11" FontFamily="Consolas" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource PrimaryActionBtn}" Margin="0,0,6,0" Click="BtnSaveFile_Click" Padding="10,5" FontSize="11">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconSave}" Fill="{DynamicResource BrushAccentText}" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                            <TextBlock Text="Save File" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Grid Margin="0,0,6,0">
                                        <Button x:Name="BtnSwitchModel" Style="{StaticResource BlackBoxActionBtn}" Click="BtnSwitchModel_Click" Padding="10,5" FontSize="11">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconSwap}" Fill="{DynamicResource BrushTextSecondary}" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                <TextBlock Text="Switch Model" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Popup x:Name="ModelPickerPopup" PlacementTarget="{Binding ElementName=BtnSwitchModel}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Slide" HorizontalOffset="0" VerticalOffset="4">
                                            <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="260" MaxHeight="360">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.45" Color="#000000"/>
                                                </Border.Effect>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Top" Text="SELECT MODEL" Foreground="{DynamicResource BrushTextDim}" FontSize="9.5" FontWeight="Bold" FontFamily="Consolas" Margin="8,6,8,6"/>
                                                    <ListBox x:Name="ModelPickerList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ModelPickerList_SelectionChanged">
                                                        <ListBox.ItemContainerStyle>
                                                            <Style TargetType="ListBoxItem">
                                                                <Setter Property="Padding" Value="0"/>
                                                                <Setter Property="Margin" Value="0,1"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="ListBoxItem">
                                                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="8,6">
                                                                                <ContentPresenter/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushAccentGlow}"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </ListBox.ItemContainerStyle>
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Path Data="{StaticResource IconCube}" Fill="{DynamicResource BrushAccentText}" Stretch="Uniform" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource BrushTextPrimary}" FontSize="12" FontWeight="SemiBold"/>
                                                                        <TextBlock Text="{Binding Provider}" Foreground="{DynamicResource BrushTextDim}" FontSize="10" FontFamily="Consolas"/>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                </DockPanel>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                    <Button Style="{StaticResource GhostToolBtn}" Margin="0,0,4,0" Click="BtnWorkspaceExplorer_Click" Padding="9,5" FontSize="11">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconFolder}" Fill="{DynamicResource BrushTextSecondary}" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                            <TextBlock Text="Explorer" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GhostToolBtn}" Margin="0,0,4,0" Click="BtnSystemInstruction_Click" Padding="9,5" FontSize="11" ToolTip="Edit the system instruction sent on every request">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconBolt}" Fill="{DynamicResource BrushTextSecondary}" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                            <TextBlock Text="System Prompt" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GhostToolBtn}" Click="BtnClearChat_Click" Padding="9,5" FontSize="11" Margin="0,0,4,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconTrash}" Fill="{DynamicResource BrushTextSecondary}" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                            <TextBlock Text="Clear Chat" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnToggleUtilityPanel" ToolTip="Toggle / Restore Right Utility Panel (Ctrl+Shift+U)" Style="{StaticResource GhostToolBtn}" Padding="9,5" FontSize="11" Margin="0,0,4,0" Click="BtnToggleUtilityPanel_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconChart}" Fill="{DynamicResource BrushTextSecondary}" Stretch="Uniform" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Panel" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnToggleClassicInspector" Content="Classic" ToolTip="Switch between Modern Right Utility Panel and Legacy Inspector / Cmd Runner" Style="{StaticResource GhostToolBtn}" Padding="9,5" FontSize="10.5" Click="BtnToggleClassicInspector_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Main 3-Column Floating Glass Cockpit -->
                        <Grid Grid.Row="1" Margin="8,0,8,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="228" MinWidth="180" MaxWidth="350"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*" MinWidth="360"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition x:Name="ColRightUtility" Width="396" MinWidth="260" MaxWidth="760"/>
                            </Grid.ColumnDefinitions>

                            <!-- ================= COLUMN 0: LEFT FILE EXPLORER ================= -->
                            <Border Grid.Column="0" Style="{StaticResource GlassPanelSurface}" ClipToBounds="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="36"/> <!-- Title & quick buttons -->
                                        <RowDefinition Height="*"/>  <!-- File list -->
                                        <RowDefinition Height="26"/> <!-- Footer stats -->
                                    </Grid.RowDefinitions>

                                    <!-- Explorer Header -->
                                    <Border Grid.Row="0" Background="{DynamicResource BrushGlassHeader}" BorderThickness="0" CornerRadius="14,14,0,0" Padding="12,0">
                                        <Grid VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconFolder}" Fill="{DynamicResource BrushAccentLight}" Stretch="Uniform" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                <TextBlock Text="EXPLORER" Foreground="{DynamicResource BrushTextSecondary}" FontWeight="Bold" FontSize="10.5" FontFamily="Consolas" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Style="{StaticResource GhostToolBtn}" Padding="6,3" Margin="0,0,2,0" FontSize="10" Click="BtnNewFile_Click" ToolTip="New file in selected folder">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconPlus}" Fill="{DynamicResource BrushTextSecondary}" Stretch="Uniform" Width="9.5" Height="9.5" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                        <TextBlock Text="File" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource GhostToolBtn}" Padding="6,3" Margin="0,0,2,0" FontSize="10" Click="BtnNewFolder_Click" ToolTip="New folder in selected folder">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconFolder}" Fill="{DynamicResource BrushTextSecondary}" Stretch="Uniform" Width="11" Height="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                        <TextBlock Text="Dir" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource GhostToolBtn}" Padding="6,3" FontSize="10" Click="BtnRefreshFiles_Click" ToolTip="Refresh file tree">
                                                    <Path Data="{StaticResource IconRefresh}" Fill="{DynamicResource BrushTextSecondary}" Stretch="Uniform" Width="11" Height="11"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Explorer File Items (Auto-Detected Language Vector/Pill Badges + Hover Spring) -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="ProjectFilesList" Margin="6,5">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Background="Transparent" BorderThickness="0" Padding="6,4.5" Margin="0,1" HorizontalContentAlignment="Stretch" Cursor="Hand" Click="BtnSelectFile_Click" Tag="{Binding}"
                                                            AllowDrop="True" PreviewMouseLeftButtonDown="FileRow_PreviewMouseDown" PreviewMouseMove="FileRow_PreviewMouseMove" DragOver="FileRow_DragOver" Drop="FileRow_Drop">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="fileRow" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                                                                    <Border.RenderTransform>
                                                                        <ScaleTransform x:Name="rowScale" ScaleX="1" ScaleY="1"/>
                                                                    </Border.RenderTransform>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Border x:Name="selBar" Grid.Column="0" Width="2.5" CornerRadius="1.5" Background="{DynamicResource BrushAccent}" Visibility="Collapsed" Margin="0,1,6,1"/>
                                                                        <ContentPresenter Grid.Column="1"/>
                                                                    </Grid>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <EventTrigger RoutedEvent="MouseEnter">
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetName="rowScale" Storyboard.TargetProperty="ScaleX" To="1.016" Duration="0:0:0.12">
                                                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                                </DoubleAnimation>
                                                                                <DoubleAnimation Storyboard.TargetName="rowScale" Storyboard.TargetProperty="ScaleY" To="1.016" Duration="0:0:0.12">
                                                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                                </DoubleAnimation>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </EventTrigger>
                                                                    <EventTrigger RoutedEvent="MouseLeave">
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetName="rowScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.14">
                                                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                                </DoubleAnimation>
                                                                                <DoubleAnimation Storyboard.TargetName="rowScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.14">
                                                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                                </DoubleAnimation>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </EventTrigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="fileRow" Property="Background" Value="{DynamicResource BrushGlassCardHover}"/>
                                                                        <Setter TargetName="fileRow" Property="BorderBrush" Value="{DynamicResource BrushGlassBorder}"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsPressed" Value="True">
                                                                        <Setter TargetName="fileRow" Property="Background" Value="{DynamicResource BrushBorderSubtle}"/>
                                                                    </Trigger>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter TargetName="fileRow" Property="Background" Value="{DynamicResource BrushAccentGlow}"/>
                                                                        <Setter TargetName="fileRow" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                                                        <Setter TargetName="selBar" Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <Grid Margin="{Binding IndentThickness}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="12"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Chevron}" Foreground="{DynamicResource BrushTextMuted}" FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                            <!-- Folder Icon OR Auto-Detected Language Badge Pill -->
                                                            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,7,0">
                                                                <Path Data="{StaticResource IconFolder}" Fill="{Binding IconColor}" Stretch="Uniform" Width="13" Height="13" Visibility="{Binding FolderVisibility}"/>
                                                                <Border Visibility="{Binding FileBadgeVisibility}" Background="{Binding BadgeBgHex}" BorderBrush="{Binding BadgeBorderHex}" BorderThickness="1" CornerRadius="4" Padding="4,1" MinWidth="26">
                                                                    <TextBlock Text="{Binding LanguageBadge}" Foreground="{Binding IconColor}" FontFamily="Consolas" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </Grid>
                                                            <TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="{DynamicResource BrushTextPrimary}" FontSize="11.5" FontFamily="Consolas, Segoe UI" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding SizeFormatted}" Foreground="{DynamicResource BrushTextDim}" FontSize="10" FontFamily="Consolas" VerticalAlignment="Center" Margin="4,0,2,0"/>
                                                                <Button Content="⋮" ToolTip="Actions" Style="{StaticResource FileRowIconBtn}" FontSize="15" FontWeight="Bold" Click="BtnFileMenu_Click" Tag="{Binding}">
                                                                    <Button.ContextMenu>
                                                                        <ContextMenu>
                                                                            <MenuItem Header="📄  New File here" Click="BtnNewFileHere_Click" Tag="{Binding}"/>
                                                                            <MenuItem Header="📁  New Folder here" Click="BtnNewFolderHere_Click" Tag="{Binding}"/>
                                                                            <Separator/>
                                                                            <MenuItem Header="✎  Rename" Click="BtnRenameFile_Click" Tag="{Binding}"/>
                                                                            <MenuItem Header="↪  Move to…" Click="BtnMoveFile_Click" Tag="{Binding}"/>
                                                                            <MenuItem Header="🗑  Delete" Click="BtnDeleteFile_Click" Tag="{Binding}"/>
                                                                        </ContextMenu>
                                                                    </Button.ContextMenu>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                        <Button.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="📄  New File here" Click="BtnNewFileHere_Click" Tag="{Binding}"/>
                                                                <MenuItem Header="📁  New Folder here" Click="BtnNewFolderHere_Click" Tag="{Binding}"/>
                                                                <Separator/>
                                                                <MenuItem Header="Rename…" Click="BtnRenameFile_Click" Tag="{Binding}"/>
                                                                <MenuItem Header="Move to…" Click="BtnMoveFile_Click" Tag="{Binding}"/>
                                                                <MenuItem Header="Delete" Click="BtnDeleteFile_Click" Tag="{Binding}"/>
                                                            </ContextMenu>
                                                        </Button.ContextMenu>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!-- Explorer Footer -->
                                    <Border Grid.Row="2" Background="{DynamicResource BrushGlassHeader}" BorderThickness="0" CornerRadius="0,0,14,14" Padding="12,0">
                                        <TextBlock x:Name="TxtExplorerStats" Text="0 items" Foreground="{DynamicResource BrushTextDim}" FontSize="10" FontFamily="Consolas" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Splitter 1 -->
                            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" Style="{StaticResource IdeSplitterStyle}" Cursor="SizeWE"/>

                            <!-- ================= COLUMN 2: CENTER WORKSPACE (EDITOR + CHAT) ================= -->
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" MinHeight="160"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="290" MinHeight="180"/>
                                </Grid.RowDefinitions>

                                <!-- Row 0: Upgraded AvalonEdit Multi-Tab Code Editor -->
                                <Border Grid.Row="0" Style="{StaticResource GlassPanelSurface}" ClipToBounds="True">
                                    <editor:CodeEditorWorkspace x:Name="CodeEditor"/>
                                </Border>

                                <!-- Horizontal Splitter -->
                                <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center" Style="{StaticResource IdeSplitterStyle}" Cursor="SizeNS"/>

                                <!-- Row 2: Center-Down Project AI Chat -->
                                <Border Grid.Row="2" Style="{StaticResource GlassPanelSurface}" ClipToBounds="True">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="34"/> <!-- Chat Header -->
                                            <RowDefinition Height="*"/>  <!-- Messages Stream -->
                                            <RowDefinition Height="Auto"/> <!-- Pending Images Bar -->
                                            <RowDefinition Height="Auto"/> <!-- Prompt Composer -->
                                        </Grid.RowDefinitions>

                                        <!-- Chat Header -->
                                        <Border Grid.Row="0" Background="{DynamicResource BrushGlassHeader}" BorderThickness="0" CornerRadius="14,14,0,0" Padding="12,0">
                                            <Grid VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource IconBolt}" Fill="{DynamicResource BrushAccentLight}" Stretch="Uniform" Width="12.5" Height="12.5" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                    <TextBlock Text="PROJECT AI CHAT" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="Bold" FontSize="10.5" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                    <Border Background="{DynamicResource BrushAccentGlow}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1" CornerRadius="999" Margin="9,0,0,0" Padding="8,1.5">
                                                        <TextBlock x:Name="TxtChatActiveModelBadge" Text="GPT-4o // Direct Cloud API" Foreground="{DynamicResource BrushAccentLight}" FontSize="9.5" FontWeight="Bold" FontFamily="Consolas"/>
                                                    </Border>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource GhostToolBtn}" Padding="8,3.5" FontSize="10" Click="BtnClearChat_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource IconTrash}" Fill="{DynamicResource BrushTextSecondary}" Stretch="Uniform" Width="11" Height="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                            <TextBlock Text="Clear" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Messages Stream (Virtualized ListBox) -->
                                        <ListBox Grid.Row="1" x:Name="ChatMessagesList"
                                                 Background="Transparent" BorderThickness="0" Padding="10,6"
                                                 VirtualizingStackPanel.IsVirtualizing="True"
                                                 VirtualizingStackPanel.VirtualizationMode="Standard"
                                                 VirtualizingPanel.ScrollUnit="Pixel"
                                                 ScrollViewer.CanContentScroll="True"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 HorizontalContentAlignment="Stretch">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Margin" Value="0"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="Focusable" Value="False"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <ContentPresenter/>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid HorizontalAlignment="{Binding Alignment}" Margin="0,4,0,6" MaxWidth="660">
                                                        <Border BorderThickness="0" CornerRadius="12" Padding="12,10" RenderTransformOrigin="0.5,0.5">
                                                            <Border.RenderTransform>
                                                                <TranslateTransform x:Name="msgLift" Y="0"/>
                                                            </Border.RenderTransform>
                                                            <Border.Triggers>
                                                                <EventTrigger RoutedEvent="Loaded">
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation From="0.35" To="1" Duration="0:0:0.2" Storyboard.TargetProperty="Opacity">
                                                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                            <DoubleAnimation Storyboard.TargetName="msgLift" Storyboard.TargetProperty="Y" From="6" To="0" Duration="0:0:0.22">
                                                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                            </Border.Triggers>
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource BrushGlassHeader}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource BrushAccentGlow}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource BrushDangerGlow}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <!-- Header row -->
                                                                <Grid Margin="0,0,0,5">
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <Border Width="20" Height="20" Background="{Binding AvatarBackground}" CornerRadius="10" Margin="0,0,7,0">
                                                                            <TextBlock Text="{Binding AvatarText}" Foreground="{DynamicResource BrushTextPrimary}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <TextBlock Text="{Binding RoleBadgeText}" Foreground="{Binding RoleColor}" FontWeight="Bold" FontSize="10" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="{Binding Timestamp}" Foreground="{DynamicResource BrushTextDim}" FontSize="9.5" FontFamily="Consolas" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                                    </StackPanel>
                                                                    <Button Style="{StaticResource GhostToolBtn}" Width="24" Height="24" Padding="0" HorizontalAlignment="Right" Click="BtnCopyChatMessage_Click" Tag="{Binding}" ToolTip="Copy message">
                                                                        <Path Data="{StaticResource IconCopy}" Fill="{DynamicResource BrushTextMuted}" Stretch="Uniform" Width="11" Height="11"/>
                                                                    </Button>
                                                                </Grid>

                                                                <!-- Attached Images if present -->
                                                                <ItemsControl ItemsSource="{Binding ImageAttachments}" Visibility="{Binding ImagesVisibility}" Margin="0,2,0,4">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel Orientation="Horizontal"/>
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Width="56" Height="56" Margin="0,0,6,4" CornerRadius="8" BorderThickness="0" ClipToBounds="True">
                                                                                <Image Source="{Binding}" Stretch="UniformToFill"/>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>

                                                                <!-- Rich Message Content + Animated States + Interactive Visual Cards -->
                                                                <rich:RichMessageView Message="{Binding}"
                                                                                      TaskChanged="WorkspaceRichMessage_TaskChanged"
                                                                                      ReviewChangesRequested="WorkspaceRichMessage_ReviewChangesRequested"
                                                                                      OpenFileRequested="WorkspaceRichMessage_OpenFileRequested"
                                                                                      RetryRequested="WorkspaceRichMessage_RetryRequested"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <!-- Pending Attached Images Bar -->
                                        <Border Grid.Row="2" x:Name="PendingImagesBar" Visibility="Collapsed" Background="{DynamicResource BrushGlassHeader}" BorderThickness="0" Padding="10,5">
                                            <ItemsControl x:Name="PendingImagesList">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="🖼️ " FontSize="11"/>
                                                                <TextBlock Text="{Binding}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10.5" FontFamily="Consolas" MaxWidth="160" TextTrimming="CharacterEllipsis"/>
                                                                <Button Content="✕" Foreground="{DynamicResource BrushDanger}" Background="Transparent" BorderThickness="0" Margin="6,0,0,0" Padding="2,0" Cursor="Hand" Click="BtnRemovePendingImage_Click" Tag="{Binding}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>

                                        <!-- Prompt Composer -->
                                        <Border Grid.Row="3" Background="{DynamicResource BrushGlassHeader}" BorderThickness="0" CornerRadius="0,0,14,14" Padding="10,8">
                                            <StackPanel>
                                                <!-- Thinking indicator (animated while the model generates) -->
                                                <Border x:Name="ThinkingIndicator" Visibility="Collapsed" Margin="0,0,0,6" Padding="10,6"
                                                        Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushAccentMuted}" BorderThickness="1" CornerRadius="6" HorizontalAlignment="Left" MaxWidth="520">
                                                    <StackPanel>
                                                        <!-- Header row: click to expand/collapse the reasoning step log -->
                                                        <StackPanel x:Name="ThinkingHeader" Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand" Background="Transparent" MouseLeftButtonUp="ThinkingHeader_Click">
                                                            <Ellipse x:Name="ThinkDot1" Width="7" Height="7" Fill="{DynamicResource BrushAccentLight}" Margin="0,0,4,0"/>
                                                            <Ellipse x:Name="ThinkDot2" Width="7" Height="7" Fill="{DynamicResource BrushAccentLight}" Margin="0,0,4,0"/>
                                                            <Ellipse x:Name="ThinkDot3" Width="7" Height="7" Fill="{DynamicResource BrushAccentLight}" Margin="0,0,8,0"/>
                                                            <TextBlock x:Name="TxtThinking" Text="Model is thinking…" FontSize="11.5" FontFamily="Consolas" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="TxtStepChevron" Text=" ▸" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                        </StackPanel>
                                                        <!-- Collapsible reasoning step log (accumulates this turn's steps) -->
                                                        <ItemsControl x:Name="StepLog" Visibility="Collapsed" Margin="15,6,0,2" MaxHeight="180">
                                                            <ItemsControl.Template>
                                                                <ControlTemplate TargetType="ItemsControl">
                                                                    <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                                                                </ControlTemplate>
                                                            </ItemsControl.Template>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding}" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,1,0,1"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Chat Prompt Textbox Capsule -->
                                                <Border Grid.Column="0" Background="{DynamicResource BrushGlassSurface}" BorderThickness="0" CornerRadius="10" Padding="4,2">
                                                    <TextBox x:Name="TxtChatPromptInput"
                                                             Background="Transparent"
                                                             Foreground="{DynamicResource BrushTextPrimary}"
                                                             CaretBrush="{DynamicResource BrushAccentLight}"
                                                             BorderThickness="0"
                                                             FontSize="12"
                                                             FontFamily="Consolas, Segoe UI"
                                                             Padding="9,6"
                                                             AcceptsReturn="True"
                                                             TextWrapping="Wrap"
                                                             MinHeight="36"
                                                             MaxHeight="72"
                                                             KeyDown="TxtChatPromptInput_KeyDown"/>
                                                </Border>

                                                <!-- Action Buttons -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="6,0,0,0">
                                                    <Button ToolTip="Attach Image or Asset to Chat" Style="{StaticResource GhostToolBtn}" Padding="9,7" Margin="0,0,5,0" Click="BtnAttachImage_Click">
                                                        <Path Data="{StaticResource IconImage}" Fill="{DynamicResource BrushTextSecondary}" Stretch="Uniform" Width="13" Height="13"/>
                                                    </Button>
                                                    <Button x:Name="BtnStopChatGeneration" Content="■ Stop" Visibility="Collapsed" Background="#ef4444" Foreground="White" BorderThickness="0" Padding="12,6" Cursor="Hand" FontWeight="SemiBold" Click="BtnStopChatGeneration_Click"/>
                                                    <Button x:Name="BtnSendChatMessage" Style="{StaticResource PrimaryActionBtn}" Padding="13,7" Click="BtnSendChatMessage_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource IconSend}" Fill="{DynamicResource BrushAccentText}" Stretch="Uniform" Width="12.5" Height="12.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                            <TextBlock Text="Send" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Splitter 2 -->
                            <GridSplitter x:Name="ColRightSplitter" Grid.Column="3" Width="8" HorizontalAlignment="Center" Style="{StaticResource IdeSplitterStyle}" Cursor="SizeWE"/>

                            <!-- ================= COLUMN 4: COLLAPSIBLE RIGHT UTILITY PANEL (+ Legacy Classic Migration Host) ================= -->
                            <Grid Grid.Column="4">
                                <utility:RightUtilityPanel x:Name="UtilityPanel" Visibility="Visible"/>
                                <Border x:Name="LegacyInspectorRoot" Visibility="Collapsed" Style="{StaticResource GlassPanelSurface}" ClipToBounds="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="38"/> <!-- Tabs Bar -->
                                        <RowDefinition Height="*"/>  <!-- Tab Contents -->
                                    </Grid.RowDefinitions>

                                    <!-- 4-Tab Bento Pill Navigation Header (Borderless Tonal Container) -->
                                    <Border Grid.Row="0" Background="{DynamicResource BrushGlassHeader}" BorderThickness="0" CornerRadius="14,14,0,0" Padding="8,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0" x:Name="BtnInspectorTabInfo" Style="{StaticResource BentoTileBtnActive}" Padding="6,6" Margin="0,0,4,0" FontSize="10.5" Click="BtnInspectorTab_Click" Tag="0">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Path Data="{StaticResource IconInfo}" Fill="{DynamicResource BrushAccentLight}" Stretch="Uniform" Width="11.5" Height="11.5" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                    <TextBlock Text="Info" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="1" x:Name="BtnInspectorTabDiff" Style="{StaticResource BentoTileBtn}" Padding="6,6" Margin="0,0,4,0" FontSize="10.5" Click="BtnInspectorTab_Click" Tag="1">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Path Data="{StaticResource IconDiff}" Fill="{DynamicResource BrushTextSecondary}" Stretch="Uniform" Width="11.5" Height="11.5" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                    <TextBlock Text="Diff" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="2" x:Name="BtnInspectorTabCmd" Style="{StaticResource BentoTileBtn}" Padding="6,6" Margin="0,0,4,0" FontSize="10.5" Click="BtnInspectorTab_Click" Tag="2">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Path Data="{StaticResource IconTerminal}" Fill="{DynamicResource BrushTextSecondary}" Stretch="Uniform" Width="11.5" Height="11.5" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                    <TextBlock Text="Cmd" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="3" x:Name="BtnInspectorTabArtifacts" Style="{StaticResource BentoTileBtn}" Padding="6,6" Margin="0" FontSize="10.5" Click="BtnInspectorTab_Click" Tag="3">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Path Data="{StaticResource IconImage}" Fill="{DynamicResource BrushTextSecondary}" Stretch="Uniform" Width="11.5" Height="11.5" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                    <TextBlock Text="Media" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Tab 0: Project & Model Info -->
                                    <ScrollViewer Grid.Row="1" x:Name="TabContentInfo" Visibility="Visible" VerticalScrollBarVisibility="Auto" Padding="10">
                                        <StackPanel>
                                            <!-- Card: Project Metadata -->
                                            <Border Background="{DynamicResource BrushGlassHeader}" BorderThickness="0" CornerRadius="12" Padding="14,12" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                        <Border Width="3" Height="12" CornerRadius="1.5" Background="{DynamicResource BrushAccent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBlock Text="Project" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <Grid Margin="0,3">
                                                        <TextBlock Text="Name" Foreground="{DynamicResource BrushTextMuted}" FontSize="11"/>
                                                        <TextBlock x:Name="TxtInfoProjectName" Text="Alpha-Project" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="11.5" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <Grid Margin="0,3">
                                                        <TextBlock Text="Total Files" Foreground="{DynamicResource BrushTextMuted}" FontSize="11"/>
                                                        <TextBlock x:Name="TxtInfoFilesCount" Text="3 files" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" FontFamily="Consolas" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <Grid Margin="0,3">
                                                        <TextBlock Text="Total Size" Foreground="{DynamicResource BrushTextMuted}" FontSize="11"/>
                                                        <TextBlock x:Name="TxtInfoProjectSize" Text="4.2 KB" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" FontFamily="Consolas" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <Border Height="1" Background="{DynamicResource BrushHoverTint}" Margin="0,9,0,8"/>
                                                    <TextBlock Text="Location" Foreground="{DynamicResource BrushTextDim}" FontSize="10.5" Margin="0,0,0,2"/>
                                                    <TextBlock x:Name="TxtInfoProjectPath" Text="G:\tools\LlmodelBox\projects\Alpha" Foreground="{DynamicResource BrushTextMuted}" FontSize="10" FontFamily="Consolas" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Card: Active Model Telemetry -->
                                            <Border Background="{DynamicResource BrushGlassHeader}" BorderThickness="0" CornerRadius="12" Padding="14,12" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                        <Border Width="3" Height="12" CornerRadius="1.5" Background="{DynamicResource BrushAccent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBlock Text="Active Model" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <Grid Margin="0,3">
                                                        <TextBlock Text="Model" Foreground="{DynamicResource BrushTextMuted}" FontSize="11"/>
                                                        <TextBlock x:Name="TxtInfoModelName" Text="GPT-4o" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="11.5" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <Grid Margin="0,3">
                                                        <TextBlock Text="Provider" Foreground="{DynamicResource BrushTextMuted}" FontSize="11"/>
                                                        <TextBlock x:Name="TxtInfoModelProvider" Text="OpenAI" Foreground="{DynamicResource BrushAccentLight}" FontSize="11" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <Grid Margin="0,3">
                                                        <TextBlock Text="Model ID" Foreground="{DynamicResource BrushTextMuted}" FontSize="11"/>
                                                        <TextBlock x:Name="TxtInfoModelId" Text="gpt-4o" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10.5" FontFamily="Consolas" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <Grid Margin="0,3">
                                                        <TextBlock Text="Context Window" Foreground="{DynamicResource BrushTextMuted}" FontSize="11"/>
                                                        <TextBlock x:Name="TxtInfoModelContext" Text="128k tokens" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" FontFamily="Consolas" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <Grid Margin="0,3">
                                                        <TextBlock Text="Pricing" Foreground="{DynamicResource BrushTextMuted}" FontSize="11"/>
                                                        <TextBlock x:Name="TxtInfoModelPricing" Text="$0.005 / 1k" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" FontFamily="Consolas" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <Border Height="1" Background="{DynamicResource BrushHoverTint}" Margin="0,9,0,8"/>
                                                    <Grid>
                                                        <TextBlock Text="API Key" Foreground="{DynamicResource BrushTextMuted}" FontSize="11" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="TxtInfoModelKeyStatus" Text="VALIDATED ✓" Foreground="{DynamicResource BrushSuccess}" FontWeight="SemiBold" FontSize="10.5" FontFamily="Consolas" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <!-- Card: Real-time Ping Latency -->
                                            <Border Background="{DynamicResource BrushGlassHeader}" BorderThickness="0" CornerRadius="12" Padding="14,12" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                        <Border Width="3" Height="12" CornerRadius="1.5" Background="{DynamicResource BrushAccent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBlock Text="Endpoint Health" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="TxtInfoPingResult" Text="Ping latency: Ready — click below to test" Foreground="{DynamicResource BrushTextMuted}" FontSize="10.5" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                                    <Button Content="Ping Active Model Endpoint" Style="{StaticResource PrimaryActionBtn}" HorizontalAlignment="Stretch" Padding="8,7" FontSize="11" Click="BtnPingActiveModel_Click"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Card: Token & Context Analysis Engine -->
                                            <Border Background="{DynamicResource BrushGlassHeader}" BorderThickness="0" CornerRadius="12" Padding="14,12">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                        <Border Width="3" Height="12" CornerRadius="1.5" Background="{DynamicResource BrushAccent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <TextBlock Text="Token &amp; Context Analysis" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- Context Window Gauge Header -->
                                                    <Grid Margin="0,0,0,4">
                                                        <TextBlock Text="Context Window Load" Foreground="{DynamicResource BrushTextMuted}" FontSize="10.5" FontFamily="Consolas"/>
                                                        <TextBlock x:Name="TxtInfoContextGaugeText" Text="0 / 128,000 (0%)" Foreground="{DynamicResource BrushAccentLight}" FontSize="10.5" FontWeight="SemiBold" FontFamily="Consolas" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <!-- Gauge ProgressBar -->
                                                    <Border Height="6" Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="3" Margin="0,0,0,10">
                                                        <ProgressBar x:Name="PbContextGauge" Minimum="0" Maximum="100" Value="0" Height="4" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource BrushAccent}"/>
                                                    </Border>

                                                    <Grid Margin="0,2.5">
                                                        <TextBlock Text="Editor Buffer" Foreground="{DynamicResource BrushTextMuted}" FontSize="11"/>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <TextBlock x:Name="TxtInfoEditorChars" Text="0 chars" Foreground="{DynamicResource BrushTextDim}" FontSize="10" FontFamily="Consolas" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="TxtInfoEditorTokens" Text="0 tokens" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <Grid Margin="0,2.5">
                                                        <TextBlock Text="Chat History" Foreground="{DynamicResource BrushTextMuted}" FontSize="11"/>
                                                        <TextBlock x:Name="TxtInfoChatTokens" Text="0 tokens" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" FontFamily="Consolas" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <Grid Margin="0,2.5">
                                                        <TextBlock Text="Chat Turns" Foreground="{DynamicResource BrushTextMuted}" FontSize="11"/>
                                                        <TextBlock x:Name="TxtInfoChatTurns" Text="0 messages" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" FontFamily="Consolas" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <Grid Margin="0,2.5">
                                                        <TextBlock Text="Tokenizer" Foreground="{DynamicResource BrushTextMuted}" FontSize="11"/>
                                                        <TextBlock x:Name="TxtInfoTokenizerSource" Text="Estimated" Foreground="{DynamicResource BrushAccentLight}" FontSize="10" FontWeight="SemiBold" FontFamily="Consolas" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <Grid Margin="0,2.5">
                                                        <TextBlock Text="Est. Query Cost" Foreground="{DynamicResource BrushTextMuted}" FontSize="11"/>
                                                        <TextBlock x:Name="TxtInfoEstCost" Text="$0.00" Foreground="{DynamicResource BrushWarning}" FontSize="11" FontWeight="SemiBold" FontFamily="Consolas" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="0,6,0,6"/>
                                                    <Grid Margin="0,1">
                                                        <TextBlock Text="Session Recorded" Foreground="{DynamicResource BrushTextMuted}" FontSize="10.5"/>
                                                        <TextBlock x:Name="TxtInfoSessionTokens" Text="0 tokens" Foreground="{DynamicResource BrushSuccess}" FontSize="10.5" FontWeight="SemiBold" FontFamily="Consolas" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <Grid Margin="0,1">
                                                        <TextBlock Text="Avg Throughput" Foreground="{DynamicResource BrushTextMuted}" FontSize="10.5"/>
                                                        <TextBlock x:Name="TxtInfoThroughput" Text="—" Foreground="{DynamicResource BrushSuccess}" FontSize="10.5" FontFamily="Consolas" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                    <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="0,6,0,6"/>
                                                    <Grid Margin="0,1">
                                                        <TextBlock Text="Live API Stream" Foreground="{DynamicResource BrushTextMuted}" FontSize="10.5"/>
                                                        <Border Background="{DynamicResource BrushSuccessGlow}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Right">
                                                            <TextBlock Text="LIVE API VERIFIED ✓" Foreground="{DynamicResource BrushSuccess}" FontSize="9" FontWeight="Bold" FontFamily="Consolas"/>
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock x:Name="TxtInfoLastLiveResponse" Text="— Awaiting first live API call" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <!-- Tab 1: Review Diff -->
                                    <Grid Grid.Row="1" x:Name="TabContentDiff" Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="36"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Diff Summary Bar -->
                                        <Border Grid.Row="0" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="8,0">
                                            <Grid VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtDiffFileName" Text="diff vs disk" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="Bold" FontSize="10.5" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                    <Border Background="{DynamicResource BrushSuccessGlow}" CornerRadius="3" Margin="6,0,0,0" Padding="4,1">
                                                        <TextBlock x:Name="TxtDiffAddedCount" Text="+0" Foreground="{DynamicResource BrushSuccess}" FontSize="10" FontWeight="Bold" FontFamily="Consolas"/>
                                                    </Border>
                                                    <Border Background="{DynamicResource BrushDangerGlow}" CornerRadius="3" Margin="4,0,0,0" Padding="4,1">
                                                        <TextBlock x:Name="TxtDiffRemovedCount" Text="-0" Foreground="{DynamicResource BrushDanger}" FontSize="10" FontWeight="Bold" FontFamily="Consolas"/>
                                                    </Border>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource BlackBoxActionBtn}" Padding="8,4" Margin="0,0,5,0" FontSize="10" Click="BtnRefreshDiff_Click" ToolTip="Refresh diff">
                                                        <TextBlock Text="↻ Refresh"/>
                                                    </Button>
                                                    <Button Style="{StaticResource PrimaryActionBtn}" Padding="10,4" FontSize="10" Click="BtnSaveFile_Click" ToolTip="Save changes to disk">
                                                        <TextBlock Text="Save File"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Diff Lines Items -->
                                        <Grid Grid.Row="1">
                                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl x:Name="DiffLinesList">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border x:Name="rowBdr" Background="Transparent">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="3"/>
                                                                        <ColumnDefinition Width="34"/>
                                                                        <ColumnDefinition Width="34"/>
                                                                        <ColumnDefinition Width="16"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border x:Name="gutter" Grid.Column="0" Background="Transparent"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayOldLine}" Foreground="{DynamicResource BrushTextDim}" FontSize="10" FontFamily="Consolas" TextAlignment="Right" Padding="0,1,6,1"/>
                                                                    <TextBlock Grid.Column="2" Text="{Binding DisplayNewLine}" Foreground="{DynamicResource BrushTextDim}" FontSize="10" FontFamily="Consolas" TextAlignment="Right" Padding="0,1,6,1"/>
                                                                    <TextBlock x:Name="pfx" Grid.Column="3" Text="{Binding Prefix}" Foreground="{DynamicResource BrushTextDim}" FontSize="10.5" FontWeight="Bold" FontFamily="Consolas" TextAlignment="Center" Padding="0,1"/>
                                                                    <TextBlock x:Name="txt" Grid.Column="4" Text="{Binding Content}" Foreground="{DynamicResource BrushTextMuted}" FontSize="11" FontFamily="Consolas" Padding="4,1,6,1" TextWrapping="Wrap"/>
                                                                </Grid>
                                                            </Border>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding Type}" Value="Added">
                                                                    <Setter TargetName="rowBdr" Property="Background" Value="{DynamicResource BrushSuccessGlow}"/>
                                                                    <Setter TargetName="gutter" Property="Background" Value="{DynamicResource BrushSuccess}"/>
                                                                    <Setter TargetName="pfx" Property="Foreground" Value="{DynamicResource BrushSuccess}"/>
                                                                    <Setter TargetName="txt" Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Type}" Value="Removed">
                                                                    <Setter TargetName="rowBdr" Property="Background" Value="{DynamicResource BrushDangerGlow}"/>
                                                                    <Setter TargetName="gutter" Property="Background" Value="{DynamicResource BrushDanger}"/>
                                                                    <Setter TargetName="pfx" Property="Foreground" Value="{DynamicResource BrushDanger}"/>
                                                                    <Setter TargetName="txt" Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Type}" Value="Header">
                                                                    <Setter TargetName="rowBdr" Property="Background" Value="{DynamicResource BrushCardInnerBg}"/>
                                                                    <Setter TargetName="txt" Property="Foreground" Value="{DynamicResource BrushAccentLight}"/>
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>

                                            <!-- Empty state: no changes vs disk -->
                                            <StackPanel x:Name="DiffEmptyState" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="✓" Foreground="{DynamicResource BrushSuccess}" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                <TextBlock Text="No changes vs disk" Foreground="{DynamicResource BrushTextSecondary}" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Edit the file to see a line-by-line diff here." Foreground="{DynamicResource BrushTextMuted}" FontSize="10.5" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>

                                    <!-- Tab 2: Cmd Runs -->
                                    <Grid Grid.Row="1" x:Name="TabContentCmd" Visibility="Collapsed" Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/> <!-- Command Presets -->
                                            <RowDefinition Height="*"/>    <!-- Output Stream -->
                                            <RowDefinition Height="Auto"/> <!-- Input Prompt -->
                                        </Grid.RowDefinitions>

                                        <!-- Command Presets Bento Chips -->
                                        <WrapPanel Grid.Row="0" Margin="0,0,0,7">
                                            <Button Style="{StaticResource BentoTileBtn}" Padding="8,4" Margin="0,0,5,5" FontSize="10" FontFamily="Consolas" Click="BtnCmdPreset_Click" Tag="python main.py">
                                                <TextBlock Text="python main.py"/>
                                            </Button>
                                            <Button Style="{StaticResource BentoTileBtn}" Padding="8,4" Margin="0,0,5,5" FontSize="10" FontFamily="Consolas" Click="BtnCmdPreset_Click" Tag="dotnet build">
                                                <TextBlock Text="dotnet build"/>
                                            </Button>
                                            <Button Style="{StaticResource BentoTileBtn}" Padding="8,4" Margin="0,0,5,5" FontSize="10" FontFamily="Consolas" Click="BtnCmdPreset_Click" Tag="dir">
                                                <TextBlock Text="dir"/>
                                            </Button>
                                            <Button Style="{StaticResource BentoTileBtn}" Padding="8,4" Margin="0,0,0,5" FontSize="10" FontFamily="Consolas" Click="BtnCmdPreset_Click" Tag="git status">
                                                <TextBlock Text="git status"/>
                                            </Button>
                                        </WrapPanel>

                                        <!-- CLI Terminal Output Card -->
                                        <Border Grid.Row="1" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="30"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <Border Grid.Row="0" Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" CornerRadius="9,9,0,0" Padding="10,0">
                                                    <Grid VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Ellipse Width="7" Height="7" Fill="{DynamicResource BrushSuccess}" Margin="0,0,7,0"/>
                                                            <TextBlock Text="CONSOLE STREAM" Foreground="{DynamicResource BrushTextSecondary}" FontSize="9.5" FontWeight="Bold" FontFamily="Consolas"/>
                                                        </StackPanel>
                                                        <Button Content="Clear" Style="{StaticResource BlackBoxActionBtn}" Padding="7,2" HorizontalAlignment="Right" FontSize="9.5" Click="BtnClearCliOutput_Click"/>
                                                    </Grid>
                                                </Border>
                                                <ScrollViewer Grid.Row="1" x:Name="CliOutputScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="10,8">
                                                    <TextBox x:Name="TxtCliOutput"
                                                             Background="Transparent"
                                                             Foreground="{DynamicResource BrushTextPrimary}"
                                                             CaretBrush="{DynamicResource BrushAccentLight}"
                                                             BorderThickness="0"
                                                             FontFamily="Consolas, Cascadia Code, Courier New"
                                                             FontSize="11.5"
                                                             IsReadOnly="True"
                                                             TextWrapping="Wrap"
                                                             AcceptsReturn="True"/>
                                                </ScrollViewer>
                                            </Grid>
                                        </Border>

                                        <!-- Command Input Capsule -->
                                        <Border Grid.Row="2" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="8,6" Margin="0,7,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="›" Foreground="{DynamicResource BrushAccentLight}" FontWeight="Bold" FontSize="15" FontFamily="Consolas" VerticalAlignment="Center" Margin="2,0,7,1"/>
                                                <TextBox Grid.Column="1" x:Name="TxtCliCommandInput"
                                                         Background="Transparent"
                                                         Foreground="{DynamicResource BrushTextPrimary}"
                                                         CaretBrush="{DynamicResource BrushAccentLight}"
                                                         BorderThickness="0"
                                                         FontSize="11.5"
                                                         FontFamily="Consolas"
                                                         VerticalAlignment="Center"
                                                         KeyDown="TxtCliCommandInput_KeyDown"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0">
                                                    <Button Content="▶ Run" Style="{StaticResource PrimaryActionBtn}" Padding="9,4" Margin="0,0,4,0" FontSize="10.5" Click="BtnRunCliCommand_Click"/>
                                                    <Button Content="⏹" Style="{StaticResource BlackBoxActionBtn}" Padding="7,4" FontSize="10.5" Click="BtnStopCliCommand_Click" ToolTip="Stop command"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- Tab 3: Artifacts & Uploads -->
                                    <Grid Grid.Row="1" x:Name="TabContentArtifacts" Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/> <!-- Upload Dropzone -->
                                            <RowDefinition Height="28"/>   <!-- Section Header -->
                                            <RowDefinition Height="*"/>    <!-- Gallery List -->
                                        </Grid.RowDefinitions>

                                        <!-- Upload Dropzone / Button -->
                                        <Border Grid.Row="0" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="10,10,10,6"
                                                AllowDrop="True" Drop="ArtifactDropZone_Drop" DragOver="ArtifactDropZone_DragOver">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="Drop images or files here" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="11.5" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Images · Code · JSON · Logs · Docs" Foreground="{DynamicResource BrushTextDim}" FontSize="9.5" HorizontalAlignment="Center" Margin="0,3,0,10"/>
                                                <Button Content="Browse Files…" Style="{StaticResource PrimaryActionBtn}" HorizontalAlignment="Center" Padding="14,6" FontSize="10.5" Click="BtnUploadArtifact_Click"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Section Header -->
                                        <Border Grid.Row="1" Background="{DynamicResource BrushWindowBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,1,0,1" Padding="10,0">
                                            <Grid VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtArtifactsCount" Text="PROJECT ARTIFACTS (0)" Foreground="{DynamicResource BrushTextMuted}" FontWeight="Bold" FontSize="10" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                <Button Content="↻" Style="{StaticResource IdeIconButton}" Width="24" Height="22" HorizontalAlignment="Right" Click="BtnRefreshArtifacts_Click" ToolTip="Refresh artifacts"/>
                                            </Grid>
                                        </Border>

                                        <!-- Artifacts & Media Items -->
                                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="10,6">
                                            <ItemsControl x:Name="ArtifactsList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,0,0,7">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="42"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Thumbnail / Icon -->
                                                                <Border Grid.Column="0" Width="40" Height="40" Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="7" ClipToBounds="True">
                                                                    <Grid>
                                                                        <Image Source="{Binding ThumbnailUri}" Stretch="UniformToFill"/>
                                                                        <TextBlock Text="{Binding Icon}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Grid>
                                                                </Border>

                                                                <!-- File Info -->
                                                                <StackPanel Grid.Column="1" Margin="8,0,4,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="11" FontFamily="Consolas, Segoe UI" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding SizeFormatted}" Foreground="{DynamicResource BrushTextDim}" FontSize="9.5" FontFamily="Consolas"/>
                                                                    <TextBlock Text="{Binding RelativePath}" Foreground="{DynamicResource BrushTextDim}" FontSize="9" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>

                                                                <!-- Action Buttons -->
                                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                    <Button Content="+ Attach" Style="{StaticResource PrimaryActionBtn}" Padding="8,3" Margin="0,0,0,4" FontSize="9.5" Click="BtnAttachArtifactToChat_Click" Tag="{Binding}" ToolTip="Attach to AI Chat"/>
                                                                    <Button Content="Open" Style="{StaticResource BlackBoxActionBtn}" Padding="8,3" FontSize="9.5" Click="BtnOpenArtifact_Click" Tag="{Binding}" ToolTip="Open file in editor or viewer"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Grid>
                                </Border>
                            </Grid>
                        </Grid>
    </Grid>
</UserControl>
