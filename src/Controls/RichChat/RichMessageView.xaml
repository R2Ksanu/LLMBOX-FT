<UserControl x:Class="LlmodelBox.Controls.RichChat.RichMessageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SnapsToDevicePixels="True">
    <StackPanel>
        <!-- Real-Time Claude / Codex Style Active Work Card -->
        <Border x:Name="ActivityHeaderBorder"
                Visibility="Collapsed"
                Background="#1238bdf8"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="10"
                Margin="0,0,0,8"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="11,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Animated Indicator: Pulsing Sonar Ring + 3-Dot Wave OR Smooth Spinner -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Grid x:Name="SonarBeacon" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Ellipse x:Name="SonarRing" Width="12" Height="12" Stroke="{DynamicResource BrushAccent}" StrokeThickness="1.5" Opacity="0.65" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="SonarScale" ScaleX="1" ScaleY="1"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="SonarCore" Width="6" Height="6" Fill="{DynamicResource BrushAccentLight}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel x:Name="ThreeDotsPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Visible">
                            <Ellipse x:Name="Dot1" Width="5" Height="5" Fill="{DynamicResource BrushAccent}" Margin="0,0,3,0"/>
                            <Ellipse x:Name="Dot2" Width="5" Height="5" Fill="{DynamicResource BrushAccent}" Margin="0,0,3,0" Opacity="0.6"/>
                            <Ellipse x:Name="Dot3" Width="5" Height="5" Fill="{DynamicResource BrushAccent}" Opacity="0.3"/>
                        </StackPanel>

                        <Border x:Name="SpinnerPanel" Width="14" Height="14" Visibility="Collapsed" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotateTransform" Angle="0"/>
                            </Border.RenderTransform>
                            <Ellipse Width="12" Height="12" Stroke="{DynamicResource BrushAccentLight}" StrokeThickness="2" StrokeDashArray="3,2"/>
                        </Border>
                    </StackPanel>

                    <!-- Center Activity Text + Active File Chip + Edit Line Counters -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtActivityText"
                                       Text="Thinking..."
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       TextWrapping="Wrap"/>
                            <Border x:Name="ActiveFileChip"
                                    Visibility="Collapsed"
                                    Background="{DynamicResource BrushCardInnerBg}"
                                    BorderBrush="{DynamicResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="7,1.5"
                                    Margin="8,0,0,0">
                                <TextBlock x:Name="TxtActiveFile"
                                           FontFamily="Cascadia Code, Consolas"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource BrushAccentLight}"/>
                            </Border>
                            <TextBlock x:Name="TxtEditCounts"
                                       Visibility="Collapsed"
                                       FontFamily="Consolas"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       Margin="8,1,0,0"/>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Right Elapsed Time + Status Pill -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock x:Name="TxtElapsedTime"
                                   Visibility="Collapsed"
                                   FontFamily="Consolas"
                                   FontSize="10"
                                   Foreground="{DynamicResource BrushTextDim}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <Border x:Name="ActivityStatusPill"
                                Background="#2238bdf8"
                                BorderBrush="{DynamicResource BrushAccent}"
                                BorderThickness="1"
                                CornerRadius="999"
                                Padding="8,2">
                            <TextBlock x:Name="TxtActivityStatusBadge"
                                       Text="THINKING"
                                       FontFamily="Consolas"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushAccentLight}"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Gliding Progress Bar Shimmer along Bottom Edge of Active Work Card -->
                <Grid x:Name="ActivityShimmerTrack" Grid.Row="1" Background="#1638bdf8" ClipToBounds="True">
                    <Border x:Name="ActivityShimmerBar" Width="140" Height="2" HorizontalAlignment="Left" CornerRadius="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#003b82f6" Offset="0"/>
                                <GradientStop Color="#60a5fa" Offset="0.5"/>
                                <GradientStop Color="#003b82f6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="ShimmerTranslate" X="-140"/>
                        </Border.RenderTransform>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Dynamic Structured Content Blocks & Markdown Prose -->
        <StackPanel x:Name="BlocksHost"/>

        <!-- Claude / Codex Style Collapsible Execution Timeline Accordion -->
        <Border x:Name="ToolTimelineContainer"
                Visibility="Collapsed"
                Background="{DynamicResource BrushCardBg}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="9"
                Margin="0,8,0,0"
                ClipToBounds="True">
            <StackPanel>
                <Button x:Name="BtnToggleToolTimeline"
                        Style="{StaticResource BlackBoxActionBtn}"
                        BorderThickness="0"
                        Background="Transparent"
                        HorizontalContentAlignment="Stretch"
                        Padding="10,7"
                        Click="BtnToggleToolTimeline_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtTimelineChevron"
                                       Text="▸"
                                       FontSize="12"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,7,0"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform x:Name="TimelineChevronRotate" Angle="0"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <Ellipse x:Name="TimelineStatusDot" Width="6.5" Height="6.5" Fill="{DynamicResource BrushSuccess}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtToolTraceHeader"
                                       Text="Completed 0 steps"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Grid.Column="2" Background="{DynamicResource BrushGlassSurface}" BorderThickness="0" CornerRadius="999" Padding="8,2">
                            <TextBlock x:Name="TxtToolTraceActionSummary" Text="TIMELINE" FontFamily="Consolas" FontSize="9" Foreground="{DynamicResource BrushTextDim}"/>
                        </Border>
                    </Grid>
                </Button>

                <Border x:Name="ToolTimelineBody"
                        Visibility="Collapsed"
                        Background="{DynamicResource BrushGlassHeader}"
                        BorderThickness="0"
                        CornerRadius="0,0,12,12"
                        Padding="12,9">
                    <StackPanel x:Name="ToolTraceList"/>
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
