<UserControl x:Class="LlmodelBox.Controls.NeuralNet3DVisualizer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DesignHeight="520" d:DesignWidth="900"
             ClipToBounds="True">
    <Grid Background="{DynamicResource BrushCardInnerBg}">
        <Viewport3D x:Name="Viewport">
            <Viewport3D.Camera>
                <PerspectiveCamera x:Name="Cam" Position="0,4,18" LookDirection="0,-4,-18" UpDirection="0,1,0" FieldOfView="55"/>
            </Viewport3D.Camera>
            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <Model3DGroup x:Name="SceneRoot">
                        <AmbientLight Color="#404050"/>
                        <DirectionalLight Color="#8090B0" Direction="-1,-1,-2"/>
                        <DirectionalLight Color="#404860" Direction="1,1,2"/>
                    </Model3DGroup>
                </ModelVisual3D.Content>
            </ModelVisual3D>
        </Viewport3D>

        <!-- Mouse capture surface for orbit/zoom -->
        <Border x:Name="InputSurface" Background="Transparent"
                MouseLeftButtonDown="Surface_MouseDown" MouseLeftButtonUp="Surface_MouseUp"
                MouseMove="Surface_MouseMove" MouseWheel="Surface_MouseWheel"/>

        <!-- Floating 3D-anchored node labels (name + live verbose status) -->
        <Canvas x:Name="LabelOverlay" IsHitTestVisible="False"/>

        <!-- 2D overlay: hint -->
        <TextBlock Text="drag to orbit · scroll to zoom · signals fire in real time"
                   FontFamily="Consolas" FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14,0,0,10" IsHitTestVisible="False"/>
    </Grid>
</UserControl>
