<UserControl x:Class="LlmodelBox.Controls.UtilityPanel.RightUtilityPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:rich="clr-namespace:LlmodelBox.Controls.RichChat"
             SnapsToDevicePixels="True">
    <Grid>
        <!-- ================= EXPANDED UTILITY PANEL (CURVED BENTO & OMNIBOX) ================= -->
        <Border x:Name="ExpandedRoot"
                Background="{DynamicResource BrushWindowBg}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="10"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Omnibox + Window Controls -->
                    <RowDefinition Height="Auto"/> <!-- Curved 3x2 Bento Tool Grid + Quick Strip -->
                    <RowDefinition Height="*"/>    <!-- Active Tool Viewport -->
                </Grid.RowDefinitions>

                <!-- Row 0: Raycast/Cursor-Style Omnibox Pill + Collapse / Hide -->
                <Border Grid.Row="0" Background="{DynamicResource BrushWindowBg}" Padding="10,9,10,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="9" Padding="9,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="{StaticResource IconSearch}" Fill="{DynamicResource BrushTextDim}" Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <Grid Grid.Column="1">
                                    <TextBlock Text="Search files, URLs, commands..." FontSize="11.5" Foreground="{DynamicResource BrushTextDim}" IsHitTestVisible="False" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=TxtOmnibox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox x:Name="TxtOmnibox" Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource BrushTextPrimary}" CaretBrush="{DynamicResource BrushAccentLight}"
                                             FontSize="11.5" VerticalAlignment="Center"
                                             TextChanged="TxtOmnibox_TextChanged"
                                             GotFocus="TxtOmnibox_GotFocus"
                                             PreviewKeyDown="TxtOmnibox_PreviewKeyDown"/>
                                </Grid>
                                <Border Grid.Column="2" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Ctrl+P" FontFamily="Consolas" FontSize="9" Foreground="{DynamicResource BrushTextDim}"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Raycast/Linear Style Card Grid Omnibox Popup -->
                        <Popup x:Name="OmniboxPopup" PlacementTarget="{Binding ElementName=TxtOmnibox}" Placement="Bottom"
                               StaysOpen="False" AllowsTransparency="True" VerticalOffset="6" Width="360">
                            <Border Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="0">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="26" ShadowDepth="4" Opacity="0.55"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Padding="10,7,10,5" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1">
                                        <TextBlock Text="OMNIBOX · FILES, COMMANDS, TOOLS &amp; URLS" FontFamily="Consolas" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushTextDim}"/>
                                    </Border>
                                    <ListBox x:Name="OmniboxResultsList" Grid.Row="1" MaxHeight="300" Background="Transparent" BorderThickness="0" Padding="6"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             MouseLeftButtonUp="OmniboxResultsList_MouseLeftButtonUp"
                                             KeyDown="OmniboxResultsList_KeyDown">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0,2"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="bd" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="8,6" Cursor="Hand" RenderTransformOrigin="0.5,0.5">
                                                                <Border.RenderTransform>
                                                                    <ScaleTransform x:Name="omniScale" ScaleX="1" ScaleY="1"/>
                                                                </Border.RenderTransform>
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <EventTrigger RoutedEvent="MouseEnter">
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="omniScale" Storyboard.TargetProperty="ScaleX" To="1.016" Duration="0:0:0.1"/>
                                                                            <DoubleAnimation Storyboard.TargetName="omniScale" Storyboard.TargetProperty="ScaleY" To="1.016" Duration="0:0:0.1"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                                <EventTrigger RoutedEvent="MouseLeave">
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="omniScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.12"/>
                                                                            <DoubleAnimation Storyboard.TargetName="omniScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.12"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushHoverBg}"/>
                                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BrushAccentLight}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrushAccentGlow}"/>
                                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid HorizontalAlignment="Stretch">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="5,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Category}" FontFamily="Consolas" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource BrushAccentLight}"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="9.5" Foreground="{DynamicResource BrushTextDim}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="↵" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource BrushTextDim}" VerticalAlignment="Center" Margin="6,0,2,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Border Grid.Row="2" Background="{DynamicResource BrushWindowBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,1,0,0" CornerRadius="0,0,10,10" Padding="10,5">
                                        <TextBlock Text="↑ ↓ Navigate   ·   ↵ Open   ·   Esc Close" FontFamily="Consolas" FontSize="9.5" Foreground="{DynamicResource BrushTextDim}"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Popup>

                        <!-- Compact Rail Collapse & Hide Icon Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                            <Button x:Name="BtnCollapseToRail" Content="»" ToolTip="Collapse to Icon Rail" Style="{StaticResource IdeIconButton}" Width="26" Height="26" Click="BtnCollapseToRail_Click"/>
                            <Button x:Name="BtnHidePanel" Content="✕" ToolTip="Hide Right Utility Panel (Ctrl+Shift+U)" Style="{StaticResource IdeIconButton}" Width="26" Height="26" Margin="2,0,0,0" Click="BtnHidePanel_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Row 1: Curated 3x2 Bento Tool Grid + Quick Utility Strip -->
                <StackPanel Grid.Row="1" Margin="10,2,10,8">
                    <UniformGrid Rows="2" Columns="3" Margin="0,0,0,6">
                        <!-- Tile 1: Review -->
                        <Button x:Name="BtnToolReview" Tag="Review" Style="{StaticResource BentoTileBtnActive}" Margin="0,0,5,5" Click="BtnSelectTool_Click">
                            <StackPanel>
                                <Grid Margin="0,0,0,3">
                                    <Path Data="{StaticResource IconDiff}" Fill="{DynamicResource BrushAccentLight}" Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <Border Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="999" Padding="5,0" HorizontalAlignment="Right">
                                        <TextBlock x:Name="BadgeReviewCount" Text="0" FontFamily="Consolas" FontSize="9" Foreground="{DynamicResource BrushTextSecondary}"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="Review" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- Tile 2: Open File -->
                        <Button x:Name="BtnToolOpenFile" Tag="OpenFile" Style="{StaticResource BentoTileBtn}" Margin="0,0,5,5" Click="BtnSelectTool_Click">
                            <StackPanel>
                                <Grid Margin="0,0,0,3">
                                    <Path Data="{StaticResource IconFile}" Fill="{DynamicResource BrushTextSecondary}" Stretch="Uniform" Width="11" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <Border Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="999" Padding="5,0" HorizontalAlignment="Right">
                                        <TextBlock x:Name="BadgeFilesCount" Text="0" FontFamily="Consolas" FontSize="9" Foreground="{DynamicResource BrushTextDim}"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="Files" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- Tile 3: Terminal -->
                        <Button x:Name="BtnToolTerminal" Tag="Terminal" Style="{StaticResource BentoTileBtn}" Margin="0,0,0,5" Click="BtnSelectTool_Click">
                            <StackPanel>
                                <Grid Margin="0,0,0,3">
                                    <Path Data="{StaticResource IconTerminal}" Fill="{DynamicResource BrushTextSecondary}" Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <Border Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="999" Padding="5,0" HorizontalAlignment="Right">
                                        <TextBlock x:Name="BadgeTerminalCount" Text="PS" FontFamily="Consolas" FontSize="9" Foreground="{DynamicResource BrushTextDim}"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="Terminal" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- Tile 4: Browser -->
                        <Button x:Name="BtnToolBrowser" Tag="Browser" Style="{StaticResource BentoTileBtn}" Margin="0,0,5,0" Click="BtnSelectTool_Click">
                            <StackPanel>
                                <Grid Margin="0,0,0,3">
                                    <Path Data="{StaticResource IconImage}" Fill="{DynamicResource BrushTextSecondary}" Stretch="Uniform" Width="12" Height="11" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <Border Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="999" Padding="5,0" HorizontalAlignment="Right">
                                        <TextBlock Text="WEB" FontFamily="Consolas" FontSize="8.5" Foreground="{DynamicResource BrushTextDim}"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="Browser" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- Tile 5: Side Question -->
                        <Button x:Name="BtnToolSideQuestion" Tag="SideQuestion" Style="{StaticResource BentoTileBtn}" Margin="0,0,5,0" Click="BtnSelectTool_Click">
                            <StackPanel>
                                <Grid Margin="0,0,0,3">
                                    <Path Data="{StaticResource IconBolt}" Fill="{DynamicResource BrushTextSecondary}" Stretch="Uniform" Width="11" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <Border Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="999" Padding="5,0" HorizontalAlignment="Right">
                                        <TextBlock Text="AI" FontFamily="Consolas" FontSize="8.5" Foreground="{DynamicResource BrushAccentLight}"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="Side Q" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- Tile 6: Plugins -->
                        <Button x:Name="BtnToolPlugins" Tag="Plugins" Style="{StaticResource BentoTileBtn}" Margin="0,0,0,0" Click="BtnSelectTool_Click">
                            <StackPanel>
                                <Grid Margin="0,0,0,3">
                                    <Path Data="{StaticResource IconCube}" Fill="{DynamicResource BrushTextSecondary}" Stretch="Uniform" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <Border Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="999" Padding="5,0" HorizontalAlignment="Right">
                                        <TextBlock x:Name="BadgePluginsCount" Text="EXT" FontFamily="Consolas" FontSize="8.5" Foreground="{DynamicResource BrushTextDim}"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="Plugins" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <!-- Secondary Quick Utility Pill Bar -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="7" Padding="3">
                            <UniformGrid Rows="1" Columns="4">
                                <Button Content="Search" Tag="CodeSearch" Style="{StaticResource SettingsTabBtn}" Padding="4,3" FontSize="10" Click="BtnSelectTool_Click"/>
                                <Button Content="Problems" Tag="Problems" Style="{StaticResource SettingsTabBtn}" Padding="4,3" FontSize="10" Click="BtnSelectTool_Click"/>
                                <Button Content="Run/Test" Tag="RunTest" Style="{StaticResource SettingsTabBtn}" Padding="4,3" FontSize="10" Click="BtnSelectTool_Click"/>
                                <Button Content="Git" Tag="SourceControl" Style="{StaticResource SettingsTabBtn}" Padding="4,3" FontSize="10" Click="BtnSelectTool_Click"/>
                            </UniformGrid>
                        </Border>

                        <Grid Grid.Column="1" Margin="5,0,0,0">
                            <Button x:Name="BtnMoreUtilities" Content="⋯" ToolTip="More Utility Views" Style="{StaticResource BlackBoxActionBtn}" Padding="9,4" FontSize="11" Click="BtnMoreUtilities_Click"/>
                            <Popup x:Name="MoreUtilitiesPopup" PlacementTarget="{Binding ElementName=BtnMoreUtilities}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" VerticalOffset="4">
                                <Border Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="9" Padding="6" Width="210">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="4" Opacity="0.5"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="INSPECTORS &amp; TOOLS" FontSize="9" FontWeight="Bold" FontFamily="Consolas" Foreground="{DynamicResource BrushTextDim}" Margin="6,3,6,5"/>
                                        <Button Content="🧠  Memory Inspector" Tag="Memory" HorizontalContentAlignment="Left" Style="{StaticResource BlackBoxActionBtn}" Margin="0,1.5" Padding="8,5" FontSize="11" Click="BtnSelectUtilityPopup_Click"/>
                                        <Button Content="📐  Context Inspector" Tag="Context" HorizontalContentAlignment="Left" Style="{StaticResource BlackBoxActionBtn}" Margin="0,1.5" Padding="8,5" FontSize="11" Click="BtnSelectUtilityPopup_Click"/>
                                        <Button Content="⚡  Agent Activity" Tag="Activity" HorizontalContentAlignment="Left" Style="{StaticResource BlackBoxActionBtn}" Margin="0,1.5" Padding="8,5" FontSize="11" Click="BtnSelectUtilityPopup_Click"/>
                                        <Button Content="📊  Model Usage" Tag="ModelUsage" HorizontalContentAlignment="Left" Style="{StaticResource BlackBoxActionBtn}" Margin="0,1.5" Padding="8,5" FontSize="11" Click="BtnSelectUtilityPopup_Click"/>
                                        <Button Content="ℹ  Project Info" Tag="ProjectInfo" HorizontalContentAlignment="Left" Style="{StaticResource BlackBoxActionBtn}" Margin="0,1.5" Padding="8,5" FontSize="11" Click="BtnSelectUtilityPopup_Click"/>
                                        <Button Content="📁  Explorer Shortcuts" Tag="ExplorerShortcuts" HorizontalContentAlignment="Left" Style="{StaticResource BlackBoxActionBtn}" Margin="0,1.5" Padding="8,5" FontSize="11" Click="BtnSelectUtilityPopup_Click"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </Grid>
                </StackPanel>

                <!-- Row 2: Tool Views Viewport (Framed Rounded Bento Surface + Smooth Transition) -->
                <Border Grid.Row="2" Margin="10,0,10,10" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="9" ClipToBounds="True">
                    <Grid x:Name="ToolViewportGrid" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="ToolViewportTranslate" Y="0"/>
                        </Grid.RenderTransform>
                        <!-- 1. REVIEW TOOL (Dark segmented pills + Bento Empty Hub + Hunks/Side-by-Side) -->
                        <Grid x:Name="ViewReview" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition x:Name="ReviewFooterRow" Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="8,6">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="2">
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="BtnFilterAll" Content="All" Tag="All" Style="{StaticResource SettingsTabBtnActive}" Padding="7,2" FontSize="10" Click="BtnReviewFilter_Click"/>
                                                <Button x:Name="BtnFilterAi" Content="AI" Tag="AI" Style="{StaticResource SettingsTabBtn}" Padding="7,2" FontSize="10" Click="BtnReviewFilter_Click"/>
                                                <Button x:Name="BtnFilterManual" Content="Manual" Tag="Manual" Style="{StaticResource SettingsTabBtn}" Padding="7,2" FontSize="10" Click="BtnReviewFilter_Click"/>
                                                <Button x:Name="BtnFilterGit" Content="Git" Tag="Git" Style="{StaticResource SettingsTabBtn}" Padding="7,2" FontSize="10" Click="BtnReviewFilter_Click"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock x:Name="TxtReviewCount" Text="0" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource BrushTextDim}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="BtnReviewModeToggle" Content="Split" ToolTip="Toggle Side-by-Side / Inline Diff" Style="{StaticResource BlackBoxActionBtn}" Padding="8,3" FontSize="10" Margin="0,0,4,0" Click="BtnReviewModeToggle_Click"/>
                                        <Button Content="↻" ToolTip="Refresh all workspace changes" Style="{StaticResource BlackBoxActionBtn}" Padding="7,3" FontSize="10.5" Click="BtnRefreshReview_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Changed files list (auto-collapsed when 0 changes so Bento Hub fills cleanly) -->
                            <ListBox x:Name="ReviewFilesList" Grid.Row="1" MaxHeight="135" Visibility="Collapsed"
                                     Background="Transparent" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="6,4"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ReviewFilesList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,2" HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding OriginLabel}" FontFamily="Consolas" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource BrushAccentLight}"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding RelativePath}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding Additions, StringFormat=+{0}}" FontFamily="Consolas" FontSize="10" Foreground="#4ade80" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding Deletions, StringFormat=-{0}}" FontFamily="Consolas" FontSize="10" Foreground="#f87171"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="10">
                                <StackPanel x:Name="ReviewDiffHost"/>
                            </ScrollViewer>

                            <Border x:Name="ReviewActionBar" Grid.Row="3" Visibility="Collapsed" Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,1,0,0" Padding="8,6">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Open File" Style="{StaticResource PrimaryActionBtn}" Padding="9,4" FontSize="10" Margin="0,0,6,0" Click="BtnReviewOpenFile_Click"/>
                                        <Button Content="Revert" Style="{StaticResource BlackBoxActionBtn}" Padding="9,4" FontSize="10" Click="BtnReviewRevertFile_Click"/>
                                    </StackPanel>
                                    <Expander Header="History" HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource BrushTextDim}" ExpandDirection="Up">
                                        <ListBox x:Name="ReviewHistoryList" MaxHeight="100" Width="210" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" FontSize="10"/>
                                    </Expander>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 2. OPEN FILE TOOL -->
                        <Grid x:Name="ViewOpenFile" Visibility="Collapsed" Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="155"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="9,6" Margin="0,0,0,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource IconSearch}" Fill="{DynamicResource BrushTextDim}" Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center" Margin="2,0,7,0"/>
                                    <TextBox Grid.Column="1" x:Name="TxtOpenFileSearch" Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource BrushTextPrimary}" CaretBrush="{DynamicResource BrushAccentLight}" FontSize="11.5"
                                             TextChanged="TxtOpenFileSearch_TextChanged" ToolTip="Fuzzy filename or relative path search"/>
                                </Grid>
                            </Border>

                            <ListBox x:Name="OpenFileResultsList" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0,0,0,4"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     SelectionChanged="OpenFileResultsList_SelectionChanged" MouseDoubleClick="OpenFileResultsList_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="9,7" Margin="0,0,0,5">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,7,0">
                                                        <TextBlock Text="{Binding Badge}" FontFamily="Consolas" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource BrushAccentLight}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding FileName}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding RelativePath}" FontFamily="Consolas" FontSize="9.5" Foreground="{DynamicResource BrushTextDim}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Grid.Row="2" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10" Margin="0,4,0,7">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="26"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" CornerRadius="9,9,0,0" Padding="9,0">
                                        <TextBlock x:Name="TxtOpenFilePreviewTitle" Text="PREVIEW — SELECT A FILE" FontFamily="Consolas" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="9,7">
                                        <TextBlock x:Name="TxtOpenFilePreview" Text="Select a file card above to inspect its contents..." FontFamily="Cascadia Code, Consolas" FontSize="10.5" Foreground="{DynamicResource BrushTextSecondary}"/>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Open External" Style="{StaticResource BlackBoxActionBtn}" Padding="10,5" FontSize="10.5" Margin="0,0,6,0" Click="BtnOpenFileExternal_Click"/>
                                <Button Content="Open in Editor" Style="{StaticResource PrimaryActionBtn}" Padding="12,5" FontSize="10.5" Click="BtnOpenFileInEditor_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- 3. TERMINAL TOOL (Sleek Unified Curved Console) -->
                        <Grid x:Name="ViewTerminal" Visibility="Collapsed" Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Unified Single-Row Console Control Card -->
                            <Border Grid.Row="0" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="7,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ComboBox x:Name="CmbTerminalShell" Width="92" FontSize="10.5" SelectedIndex="0" Padding="7,4">
                                            <ComboBoxItem Content="PowerShell"/>
                                            <ComboBoxItem Content="CMD"/>
                                            <ComboBoxItem Content="Git Bash"/>
                                        </ComboBox>
                                        <Button Content="+" ToolTip="New Terminal Session" Style="{StaticResource PrimaryActionBtn}" Padding="8,4" FontSize="11.5" FontWeight="Bold" Margin="5,0,0,0" Click="BtnNewTerminalTab_Click"/>
                                        <Button Content="ENV" ToolTip="Toggle Environment Variables" Style="{StaticResource BlackBoxActionBtn}" Padding="7,4" FontSize="9.5" Margin="4,0,0,0" Click="BtnToggleTerminalEnv_Click"/>
                                    </StackPanel>

                                    <Border Grid.Column="1" Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="999" Padding="8,2" Margin="6,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse x:Name="TerminalStatusDot" Width="6.5" Height="6.5" Fill="{DynamicResource BrushSuccess}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtTerminalStatus" Text="Ready" FontFamily="Consolas" FontSize="9.5" Foreground="{DynamicResource BrushTextSecondary}" TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="■" ToolTip="Interrupt / Stop (Ctrl+C)" Style="{StaticResource BlackBoxActionBtn}" Padding="7,4" FontSize="10" Margin="0,0,4,0" Click="BtnTerminalInterrupt_Click"/>
                                        <Button Content="Clear" ToolTip="Clear Terminal Buffer" Style="{StaticResource BlackBoxActionBtn}" Padding="8,4" FontSize="9.5" Click="BtnTerminalClear_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Inline Session Tabs + Quick Commands + Collapsible ENV -->
                            <StackPanel Grid.Row="1" Margin="0,6,0,0">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="TerminalTabsBar" Orientation="Horizontal"/>
                                </ScrollViewer>

                                <WrapPanel Margin="0,5,0,0">
                                    <Button Style="{StaticResource BentoTileBtn}" Padding="8,3" Margin="0,0,4,0" Tag="git status" Click="BtnTerminalQuickCmd_Click">
                                        <TextBlock Text="git status" FontFamily="Consolas" FontSize="9.5"/>
                                    </Button>
                                    <Button Style="{StaticResource BentoTileBtn}" Padding="8,3" Margin="0,0,4,0" Tag="dotnet build" Click="BtnTerminalQuickCmd_Click">
                                        <TextBlock Text="dotnet build" FontFamily="Consolas" FontSize="9.5"/>
                                    </Button>
                                    <Button Style="{StaticResource BentoTileBtn}" Padding="8,3" Margin="0,0,4,0" Tag="dotnet test" Click="BtnTerminalQuickCmd_Click">
                                        <TextBlock Text="dotnet test" FontFamily="Consolas" FontSize="9.5"/>
                                    </Button>
                                    <Button Style="{StaticResource BentoTileBtn}" Padding="8,3" Margin="0" Tag="dir" Click="BtnTerminalQuickCmd_Click">
                                        <TextBlock Text="dir" FontFamily="Consolas" FontSize="9.5"/>
                                    </Button>
                                </WrapPanel>

                                <Border x:Name="TerminalEnvBar" Visibility="Collapsed" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,6,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtTerminalEnvVars" ToolTip="KEY=VAL;KEY2=VAL2" Background="{DynamicResource BrushCardInnerBg}"
                                                 Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" FontFamily="Consolas" FontSize="10.5" Padding="7,4"/>
                                        <TextBlock Grid.Column="1" Text="Applies to + Tab" FontSize="9.5" Foreground="{DynamicResource BrushTextDim}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Elevated Rounded Console Output Viewport -->
                            <Border Grid.Row="2" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10" Margin="0,6,0,7">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="26"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" CornerRadius="9,9,0,0" Padding="10,0">
                                        <TextBlock x:Name="TxtTerminalCwd" Text="Terminal Stream" FontFamily="Consolas" FontSize="9.5" Foreground="{DynamicResource BrushTextDim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                    <TextBox Grid.Row="1" x:Name="TxtTerminalTranscript"
                                             IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                             Background="Transparent" Foreground="{DynamicResource BrushTextPrimary}"
                                             BorderThickness="0" Padding="11,9" FontFamily="Cascadia Code, Consolas" FontSize="11.5"/>
                                </Grid>
                            </Border>

                            <!-- Floating Curved Command Capsule -->
                            <Border Grid.Row="3" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="9,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="›" FontFamily="Consolas" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource BrushAccentLight}" VerticalAlignment="Center" Margin="2,0,8,1"/>
                                    <TextBox Grid.Column="1" x:Name="TxtTerminalInput" Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource BrushTextPrimary}" CaretBrush="{DynamicResource BrushAccentLight}" FontFamily="Cascadia Code, Consolas" FontSize="11.5"
                                             VerticalAlignment="Center" PreviewKeyDown="TxtTerminalInput_PreviewKeyDown"/>
                                    <Button Grid.Column="2" Content="Run ↵" Style="{StaticResource PrimaryActionBtn}" Padding="11,5" FontSize="10.5" Margin="6,0,0,0" Click="BtnTerminalSend_Click"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 4. BROWSER & LIVE UI PREVIEW TOOL -->
                        <Grid x:Name="ViewBrowser" Visibility="Collapsed" Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Unified Browser Toolbar Card -->
                            <Border Grid.Row="0" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="8,7" Margin="0,0,0,7">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                            <StackPanel x:Name="BrowserTabsBar" Orientation="Horizontal"/>
                                        </ScrollViewer>
                                        <Button Grid.Column="1" Content="+" ToolTip="New Browser Tab" Style="{StaticResource BlackBoxActionBtn}" Padding="8,3" FontSize="11" Margin="4,0,0,0" Click="BtnBrowserNewTab_Click"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <Button x:Name="BtnBrowserBack" Content="←" Style="{StaticResource IdeIconButton}" Width="24" Height="24" Click="BtnBrowserBack_Click"/>
                                            <Button x:Name="BtnBrowserForward" Content="→" Style="{StaticResource IdeIconButton}" Width="24" Height="24" Margin="2,0,0,0" Click="BtnBrowserForward_Click"/>
                                            <Button Content="↻" Style="{StaticResource IdeIconButton}" Width="24" Height="24" Margin="2,0,0,0" Click="BtnBrowserReload_Click"/>
                                            <Button Content="⌂" Style="{StaticResource IdeIconButton}" Width="24" Height="24" Margin="2,0,5,0" Click="BtnBrowserHome_Click"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="8,4">
                                            <TextBox x:Name="TxtBrowserUrl" Background="Transparent" BorderThickness="0"
                                                     Foreground="{DynamicResource BrushTextPrimary}" CaretBrush="{DynamicResource BrushAccentLight}" FontFamily="Consolas" FontSize="11"
                                                     VerticalAlignment="Center" KeyDown="TxtBrowserUrl_KeyDown"/>
                                        </Border>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="5,0,0,0">
                                            <Button Content="Go" Style="{StaticResource PrimaryActionBtn}" Padding="9,4" FontSize="10" Click="BtnBrowserGo_Click"/>
                                            <Button Content="↗" ToolTip="Open External" Style="{StaticResource IdeIconButton}" Width="24" Height="24" Margin="3,0,0,0" Click="BtnBrowserOpenExternal_Click"/>
                                            <Button Content="⚙" ToolTip="Browser Settings &amp; History" Style="{StaticResource IdeIconButton}" Width="24" Height="24" Margin="2,0,0,0" Click="BtnBrowserSettings_Click"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border x:Name="BrowserSettingsDrawer" Visibility="Collapsed" Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="9" Margin="0,7,0,0">
                                        <StackPanel>
                                            <TextBlock Text="BROWSER PERMISSIONS &amp; SETTINGS" FontSize="9" FontWeight="Bold" FontFamily="Consolas" Foreground="{DynamicResource BrushTextDim}" Margin="0,0,0,5"/>
                                            <CheckBox x:Name="ChkBrowserAllowDownloads" Content="Allow Interactive File Downloads" FontSize="11" Margin="0,2" Checked="BrowserPermission_Changed" Unchecked="BrowserPermission_Changed"/>
                                            <CheckBox x:Name="ChkBrowserAllowAutomation" Content="Allow AI Browser Automation (separate)" FontSize="11" Margin="0,2" Checked="BrowserPermission_Changed" Unchecked="BrowserPermission_Changed"/>
                                            <TextBlock Text="Home URL:" FontSize="10" Foreground="{DynamicResource BrushTextDim}" Margin="0,6,0,2"/>
                                            <TextBox x:Name="TxtBrowserHomeUrl" FontSize="10.5" FontFamily="Consolas" Background="{DynamicResource BrushCardBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorder}" Padding="6,4" LostFocus="TxtBrowserHomeUrl_LostFocus"/>
                                            <TextBlock Text="Recent History / Downloads:" FontSize="10" Foreground="{DynamicResource BrushTextDim}" Margin="0,6,0,2"/>
                                            <ListBox x:Name="BrowserHistoryAndDownloadsList" MaxHeight="95" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" FontSize="10" MouseDoubleClick="BrowserHistoryItem_DoubleClick"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Rounded Preview Viewport Container -->
                            <Border Grid.Row="1" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="3" ClipToBounds="True">
                                <Border x:Name="BrowserViewportFrame" CornerRadius="8" ClipToBounds="True" HorizontalAlignment="Stretch">
                                    <Grid>
                                        <wv2:WebView2 x:Name="EmbeddedWebView"/>
                                        <TextBlock x:Name="TxtWebViewFallbackStatus" Visibility="Collapsed" TextWrapping="Wrap" Margin="16" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource BrushTextSecondary}" FontSize="11.5"/>
                                    </Grid>
                                </Border>
                            </Border>

                            <!-- Browser Status & Responsive Preview Strip -->
                            <Border Grid.Row="2" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="8,4" Margin="0,6,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="TxtBrowserStatus" Text="WebView2 Ready" FontFamily="Consolas" FontSize="9.5" Foreground="{DynamicResource BrushTextDim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                        <Button x:Name="BtnBrowserSizeAuto" Content="Full" Tag="Auto" Style="{StaticResource PrimaryActionBtn}" Padding="7,2" FontSize="9" Margin="0,0,3,0" Click="BtnBrowserViewport_Click"/>
                                        <Button x:Name="BtnBrowserSizeDesktop" Content="Desktop" Tag="1024" Style="{StaticResource BlackBoxActionBtn}" Padding="6,2" FontSize="9" Margin="0,0,3,0" Click="BtnBrowserViewport_Click"/>
                                        <Button x:Name="BtnBrowserSizeMobile" Content="Mobile" Tag="390" Style="{StaticResource BlackBoxActionBtn}" Padding="6,2" FontSize="9" Click="BtnBrowserViewport_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 5. SIDE QUESTION TOOL -->
                        <Grid x:Name="ViewSideQuestion" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="9,7">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="ISOLATED SIDE CONVERSATION" FontFamily="Consolas" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BrushAccentLight}" VerticalAlignment="Center"/>
                                        <Button Content="Clear" Style="{StaticResource BlackBoxActionBtn}" Padding="7,2" FontSize="9.5" HorizontalAlignment="Right" Click="BtnSideClear_Click"/>
                                    </Grid>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Model:" FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox Grid.Column="1" x:Name="CmbSideModel" DisplayMemberPath="Name" FontSize="10.5"/>
                                    </Grid>
                                    <WrapPanel Margin="0,6,0,0">
                                        <CheckBox x:Name="ChkSideIncludeFile" Content="Attach Open File / Selection" IsChecked="True" FontSize="10.5" Margin="0,0,10,0"/>
                                        <Button Content="+ Temp File" Style="{StaticResource BlackBoxActionBtn}" Padding="7,2" FontSize="9.5" Click="BtnSideAttachFile_Click"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="TxtSideAttachments" Visibility="Collapsed" FontFamily="Consolas" FontSize="9.5" Foreground="{DynamicResource BrushAccent}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <ScrollViewer Grid.Row="1" x:Name="SideChatScroller" VerticalScrollBarVisibility="Auto" Padding="8">
                                <ItemsControl x:Name="SideMessagesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="9,7" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding RoleBadgeText}" FontFamily="Consolas" FontSize="9.5" FontWeight="Bold" Foreground="{Binding RoleColor}"/>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <Button Content="Copy" Style="{StaticResource BlackBoxActionBtn}" Padding="6,2" FontSize="9.5" Margin="0,0,4,0" Tag="{Binding}" Click="BtnSideCopyAnswer_Click"/>
                                                            <Button Content="→ Main Chat" Style="{StaticResource PrimaryActionBtn}" Padding="7,2" FontSize="9.5" Tag="{Binding}" Click="BtnSidePromoteAnswer_Click"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <rich:RichMessageView Message="{Binding}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Border Grid.Row="2" Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,1,0,0" Padding="8,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="7" Padding="7,4">
                                        <TextBox x:Name="TxtSidePrompt" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="70" Background="Transparent" BorderThickness="0"
                                                 Foreground="{DynamicResource BrushTextPrimary}" CaretBrush="{DynamicResource BrushAccentLight}" FontSize="11.5" KeyDown="TxtSidePrompt_KeyDown"/>
                                    </Border>
                                    <Button x:Name="BtnSideSend" Grid.Column="1" Content="Ask" Style="{StaticResource PrimaryActionBtn}" Padding="11,5" Margin="6,0,0,0" VerticalAlignment="Bottom" Click="BtnSideSend_Click"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 6. PLUGINS TOOL -->
                        <Grid x:Name="ViewPlugins" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="110"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="9,7">
                                <Grid>
                                    <TextBlock Text="EXTENSION MANAGER (TRUST-GATED)" FontFamily="Consolas" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                    <Button Content="Reload" Style="{StaticResource BlackBoxActionBtn}" Padding="8,3" FontSize="10" HorizontalAlignment="Right" Click="BtnPluginsReload_Click"/>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="9">
                                <StackPanel x:Name="PluginsListHost"/>
                            </ScrollViewer>

                            <Border Grid.Row="2" Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,1,0,0" Padding="8,6">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="PLUGIN ACTIVITY &amp; ERRORS" FontFamily="Consolas" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushTextDim}" Margin="0,0,0,4"/>
                                    <ListBox x:Name="PluginLogList" Background="Transparent" BorderThickness="0" FontFamily="Consolas" FontSize="10"/>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- 7. ADDITIONAL UTILITY VIEWS HOST -->
                        <Grid x:Name="ViewUtilitiesHost" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{DynamicResource BrushCardInnerBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="9,7">
                                <Grid>
                                    <TextBlock x:Name="TxtUtilityViewTitle" Text="Utility View" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                    <Button Content="Refresh" Style="{StaticResource BlackBoxActionBtn}" Padding="8,3" FontSize="10" HorizontalAlignment="Right" Click="BtnUtilityRefresh_Click"/>
                                </Grid>
                            </Border>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="9">
                                <StackPanel x:Name="UtilityContentHost"/>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ================= COLLAPSED ICON RAIL (44px CURVED BENTO) ================= -->
        <Border x:Name="IconRailRoot"
                Visibility="Collapsed"
                Width="44"
                Background="{DynamicResource BrushWindowBg}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="4,7">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Content="«" ToolTip="Expand Utility Panel" Style="{StaticResource BlackBoxActionBtn}" Height="28" Padding="0" FontSize="12" Margin="0,0,0,6" Click="BtnExpandFromRail_Click"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Button Content="RV" ToolTip="Review Changes" Tag="Review" Style="{StaticResource BlackBoxActionBtn}" Height="30" Padding="0" FontFamily="Consolas" FontSize="10" Margin="0,2" Click="BtnRailTool_Click"/>
                        <Button Content="OF" ToolTip="Open File" Tag="OpenFile" Style="{StaticResource BlackBoxActionBtn}" Height="30" Padding="0" FontFamily="Consolas" FontSize="10" Margin="0,2" Click="BtnRailTool_Click"/>
                        <Button Content="&gt;_" ToolTip="Terminal" Tag="Terminal" Style="{StaticResource BlackBoxActionBtn}" Height="30" Padding="0" FontFamily="Consolas" FontSize="10" Margin="0,2" Click="BtnRailTool_Click"/>
                        <Button Content="WB" ToolTip="Browser" Tag="Browser" Style="{StaticResource BlackBoxActionBtn}" Height="30" Padding="0" FontFamily="Consolas" FontSize="10" Margin="0,2" Click="BtnRailTool_Click"/>
                        <Button Content="SQ" ToolTip="Side Question" Tag="SideQuestion" Style="{StaticResource BlackBoxActionBtn}" Height="30" Padding="0" FontFamily="Consolas" FontSize="10" Margin="0,2" Click="BtnRailTool_Click"/>
                        <Button Content="PL" ToolTip="Plugins" Tag="Plugins" Style="{StaticResource BlackBoxActionBtn}" Height="30" Padding="0" FontFamily="Consolas" FontSize="10" Margin="0,2" Click="BtnRailTool_Click"/>
                        <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="4,6"/>
                        <Button Content="🔎" ToolTip="Code Search" Tag="CodeSearch" Style="{StaticResource BlackBoxActionBtn}" Height="28" Padding="0" FontSize="11" Margin="0,2" Click="BtnRailTool_Click"/>
                        <Button Content="⚠" ToolTip="Problems" Tag="Problems" Style="{StaticResource BlackBoxActionBtn}" Height="28" Padding="0" FontSize="11" Margin="0,2" Click="BtnRailTool_Click"/>
                        <Button Content="▶" ToolTip="Run &amp; Test" Tag="RunTest" Style="{StaticResource BlackBoxActionBtn}" Height="28" Padding="0" FontSize="11" Margin="0,2" Click="BtnRailTool_Click"/>
                        <Button Content="⎇" ToolTip="Source Control" Tag="SourceControl" Style="{StaticResource BlackBoxActionBtn}" Height="28" Padding="0" FontSize="11" Margin="0,2" Click="BtnRailTool_Click"/>
                        <Button Content="📊" ToolTip="Model Usage" Tag="ModelUsage" Style="{StaticResource BlackBoxActionBtn}" Height="28" Padding="0" FontSize="11" Margin="0,2" Click="BtnRailTool_Click"/>
                    </StackPanel>
                </ScrollViewer>

                <Button Grid.Row="2" Content="✕" ToolTip="Hide Utility Panel" Style="{StaticResource IdeIconButton}" Width="30" Height="28" Margin="0,6,0,0" Click="BtnHidePanel_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
